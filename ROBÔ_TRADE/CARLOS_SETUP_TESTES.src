//DECLARAR VARIÁVEIS
var
  valor, variacao : real;
  comeco, final : inteiro;
  cor, espessura, estilo, fonte, posicao : inteiro;
  texto : string;

begin

// PASSO 1 | CARREGAR INDICADORES
  valor := 38;
  cor := clAmarelo;
  espessura := 6;
  estilo := psDash;
  texto := "Indicador Amarelo";
  fonte := 26;
  posicao := tpBottomLeft;
  comeco := 1251201;
  final := 1251204; 
  variacao := 0;

  HorizontalLineCustom(valor, cor, espessura,
  espessura, estilo, texto, fonte, posicao, comeco,
  final, variacao);

end;
