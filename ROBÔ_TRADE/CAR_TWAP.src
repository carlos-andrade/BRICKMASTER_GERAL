//Indicadores: TWAP e VWAP.
//Paleta: https://www.color-hex.com/color-palette/1009919
//Paleta: https://www.homehost.com.br/blog/tutoriais/tabela-de-cores-html/

const  //21.8 Função GetFeed
WINFUT = Asset("WINFUT", feedBMF);
//A1 = Asset("WDOFUT", feedBMF);
//A1 = Asset("VALE3", feedBOVESPA);
IBOV = Asset("IBOV", feedBOVESPA);


input
    periodo(60);
    

var
    vSoma : Float;
    vTwap : Float;
    vVwap : Float;

    corVwap : Integer;
    corTwap : Integer;

    corPositiva : Integer;
    corNegativa : Integer;

    corVALE3 : Integer;
    corWINFUT : Integer;

 
 vWINFUT : float;
 vIBOV   : float;
    

begin

//vSoma := Summation((Open + High + Low + Close) / 4, periodo);
vSoma := Summation((Open + High + Low + Close) / 4, periodo);
vTwap := (vSoma / periodo);
vVwap := (VWAP(0));

vWINFUT := (WINFUT.Open + WINFUT.High + WINFUT.Low + WINFUT.Close)/4;
vIBOV   := (IBOV.Open + IBOV.High + IBOV.Low + IBOV.Close)/4;

begin
  if(vVwap > vTwap) then PaintBar(corPositiva)
  else if (vVwap < vTwap) then PaintBar(corNegativa);
end;


//COLORAÇÃO

corVwap := (RGB(10,60,145));
corTwap := (RGB(252,60,35));

corPositiva := (RGB(0,255,0));
corNegativa := (RGB(255,0,0));

corVALE3 := (RGB(255,0,255));
corWINFUT := (RGB(255,255,0));

  SetPlotColor(1,corVwap);     //Azul
  SetPlotColor(2,corTwap);   //Amarelo
  SetPlotColor(6,corWINFUT);   //Amarelo
  
    
  //ESPESSURA
  SetPlotWidth(1,3); //VWAP
  SetPlotWidth(2,4); //TWAP
  
  //ESTILO DA LINHA
  SetPlotStyle(1,0); //VWAP
  SetPlotStyle(2,0); //TWAP

Plot(vVwap); //Amarela //VWAP
Plot2(vTwap);  //Azul    //TWAP
//Plot3(A1.open);
//Plot4(A1.close);
//Plot5(vWINFUT);
Plot6(vIBOV);


end;
