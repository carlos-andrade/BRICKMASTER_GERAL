// ===============================
// HIVE CORE ENGINE - BRICKMASTER
// CAR_RoyalJelly
// RENKO 15R
// ===============================

// ===== INPUTS =====
input
    DecayRate(0.95);
    MinEnergy(50);
    MaxLarvas(5);

// ===== VARIÁVEIS =====

// Fluxo

var
    IA : Float;           // Impulso de Agressão
    DF : Float;           // Densidade de Fluxo
    PL : Float;           // Pressão Líquida

// Controle de tempo
    LastTime  : Integer;
    DeltaTime : Integer;

// Arrays simulando larvas
    LarvaEnergia  : Float;
    LarvaTipo     : Float;
    LarvaPreco    : Float;

// Dominante
    DominanteID : Float;
    DominanteEnergia : Float;

//
    MaxList  : Float;
    AbsValue : Float;

begin
// ===== 1. EVENTO DE MERCADO =====

// Tempo entre ticks
DeltaTime := (CurrentTime - LastTime);
LastTime  := CurrentTime;

// Direção agressora
if Close > Close[1] then
    IA := Volume * 1
else if Close < Close[1] then
    IA := Volume * (-1)
else
    IA := 0;

// Densidade (simples)
DF := 1 / MaxList(DeltaTime, 1);

// Pressão acumulada
PL := PL + IA;

// ===== 2. GERAÇÃO DE LARVAS =====

// Tipo 1: Impulso forte
if AbsValue(IA) > Average(Volume, 20) then begin

    // Inserir nova larva no slot 0 (shift)
    for value1 = MaxLarvas downto 2 begin
        LarvaEnergia[value1] = LarvaEnergia[value1-1];
        LarvaTipo[value1] = LarvaTipo[value1-1];
        LarvaPreco[value1] = LarvaPreco[value1-1];
    end;

    LarvaEnergia[1] = AbsValue(IA);
    LarvaTipo[1] = 1;
    LarvaPreco[1] = Close;
end;

// Tipo 2: Absorção (volume alto sem deslocamento)
if Volume > Average(Volume, 20) and AbsValue(Close - Close[1]) < MinMove then begin

    LarvaEnergia[1] = Volume;
    LarvaTipo[1] = 2;
    LarvaPreco[1] = Close;
end;

// ===== 3. NUTRIÇÃO + DECAY =====

for value1 = 1 to MaxLarvas begin

    // Decaimento natural
    LarvaEnergia[value1] = LarvaEnergia[value1] * DecayRate;

    // Reforço por fluxo alinhado
    if LarvaTipo[value1] = 1 then
        LarvaEnergia[value1] = LarvaEnergia[value1] + AbsValue(IA);

    if LarvaTipo[value1] = 2 then
        LarvaEnergia[value1] = LarvaEnergia[value1] + Volume;

end;

// ===== 4. SELEÇÃO NATURAL =====

DominanteEnergia = 0;
DominanteID = -1;

for value1 = 1 to MaxLarvas begin

    if LarvaEnergia[value1] > DominanteEnergia then begin
        DominanteEnergia = LarvaEnergia[value1];
        DominanteID = value1;
    end;

end;

// ===== 5. DECISÃO =====

if DominanteEnergia > MinEnergy then begin

    if LarvaTipo[DominanteID] = 1 then begin
        Buy("Hive_Long") next bar at market;
    end;

    if LarvaTipo[DominanteID] = 2 then begin
        SellShort("Hive_Short") next bar at market;
    end;

end;

// ===== DEBUG VISUAL =====
Plot1(DominanteEnergia, "Energia Dominante");

end;
