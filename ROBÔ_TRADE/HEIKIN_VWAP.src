  // Método inspirado no Método de Joseph Reffson (MeJoRe)(Newton–Raphson)
// Versão 01, experimentos.

input
    
  //Heikin Ashi
  PeriodoHA (15); // DE 1 A 9
  TipoHA    (3); // 0 - Aritmética | 1 - Exponencial | 2 - Welles Wilder | 3 - Ponderada
  DadoHA    (1); // 1 - Fechamento | 0 - Abertura    | 2 - Máxima        | 3 - Mínima
  PrecoPassadoHAClose (2); //Banda Rápida/Leve
  PrecoPassadoHAOpen (10); //Banda Lenta/Pesada
    
 var

//3 VWAPS / TRIWAP:
vVWAPd : real; vVWAPs : real; vVWAPm : real;
vTRIWAP : real;

// 4. INDICADOR HEIKIN ASHI
HA_Close : float; HA_Open : float; HA_High : float; HA_Low : float;
vHAMedia : float; // 5. MÉDIA DAS MÉDIAS DE HEIKIN ASHI

vHeikinAshiClose : float;
vHeikinAshiOpen  : float;
vHeikinAshiMedia : float;


begin

// PASSO 1 | CARREGAR INDICADORES

//VWAPS
vVWAPd := VWAP(1); vVWAPs := VWAP(2); vVWAPm := VWAP(3);
vTRIWAP := (vVWAPd + vVWAPs + vVWAPm) / 3; // 1. MÉDIA DAS VWAP´S

 

//indicador Heikin Ashi by ChatGPT // NÃO PLOTAR
//HeikinAshi(Media : Integer,     TipoMedia : Integer)  |Dado : Integer|
                                              // PeriodoHA: // TipoHA:           // DadoHA:                    
HA_Close := HeikinAshi(PeriodoHA, TipoHA)|1|; // DE 1 A 9   // 0 - Aritmética    // |1| - Fechamento          
HA_Open  := HeikinAshi(PeriodoHA, TipoHA)|0|; // DE 1 A 9   // 1 - Exponencial   // |0| - Abertura           
HA_High  := HeikinAshi(PeriodoHA, TipoHA)|2|; // DE 1 A 9   // 2 - Welles Wilder // |2| - Máxima           
HA_Low   := HeikinAshi(PeriodoHA, TipoHA)|3|; // DE 1 A 9   // 3 - Ponderada     // |3| - Mínima 
          

vHeikinAshiClose := (HA_Close[PrecoPassadoHAClose] + HA_Open[PrecoPassadoHAClose] + HA_High[PrecoPassadoHAClose] + HA_Low[PrecoPassadoHAClose]) / 4; // PRIMEIRA LINHA HEIKIN ASHI
vHeikinAshiOpen := (HA_Close[PrecoPassadoHAOpen] + HA_Open[PrecoPassadoHAOpen]) / 2; // SEGUNDA LINHA HEIKIN ASHI
vHeikinAshiMedia := (vHeikinAshiClose + vHeikinAshiOpen) / 2; // TERCEIRA LINHA HEIKIN ASHI

// PASSO 2 | SINAIS DE ENTRADA

// PASSO 3 | SINAIS DE SAÍDA

//-----------PADRÃO----------

//EXECUÇÃO DE ENTRADA

//EXECUÇÃO DE SAÍDA

//COLORAÇÃO
//clBlack clMarrom clGreen clOlive clNavy clPurple clTeal clGray clSilver clRed clLime clYellow clBlue

SetPlotColor(1, clRed);         // 1. MÉDIA DAS VWAP´S
SetPlotColor(2, clBlack);       // 2. MÉDIA DAS MÉDIAS.
SetPlotColor(3, clSilver);       // 3. MÉDIA MÓVEL: entre Abertura, Fechamento, Máxima e Mínima - AvgPrice
SetPlotColor(4, clBranco);        // 4. INDICADOR HEIKIN ASHI

//ESPESSURA
SetPlotWidth(1, 5);    // 1. MÉDIA DAS VWAP´S
SetPlotWidth(2, 5);    // 2. MÉDIA DAS MÉDIAS.
SetPlotWidth(3, 3);    // 3. MÉDIA MÓVEL: entre Abertura, Fechamento, Máxima e Mínima - AvgPrice
SetPlotWidth(4, 3);    // 4. INDICADOR HEIKIN ASHI

//ESTILO DA LINHA
SetPlotStyle(1,2);    // 1. MÉDIA DAS VWAP´S
SetPlotStyle(2,0);    // 2. MÉDIA DAS MÉDIAS.
SetPlotStyle(3,0);    // 3. MÉDIA MÓVEL: entre Abertura, Fechamento, Máxima e Mínima - AvgPrice
SetPlotStyle(4,0);    // 4. INDICADOR HEIKIN ASHI

//PLOTAGEM
//Plot  (vTRIWAP);  //NOME: TRIWAP      //COR: VERMELHA // 1. MÉDIA DAS VWAP´S: LINHA VERMELHA.
//Plot2 (vHeikinAshiClose);                   //COR: PRETA // 2. MÉDIA DAS MÉDIAS.
//Plot3 (vHeikinAshiOpen);                        //COR: PRATA // 3. MÉDIA MÓVEL: entre Abertura, Fechamento, Máxima e Mínima
//Plot4 (vHeikinAshiMedia);      // NÃO PLOTAR      //COR: BRANCA // 4. INDICADOR HEIKIN ASHI // LINHA PRETA
 
end;
  
