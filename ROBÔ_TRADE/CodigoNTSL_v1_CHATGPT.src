//SÉRIE DE CÓDIGO REALIZADOS PELO CHATGPT
//CORRIGIDO POR CARLOS ANDRADE.
//NOME: CodigoNTSL_v1_CHATGPT

input
    PeriodoTWAP(20);

var
    vwapValue : float;
    twapValue : float;
    somaPreco : float;
    gap       : float;
    i         : integer;

begin

    // VWAP nativo
    vwapValue := (VWAP(0));

    // TWAP manual
    somaPreco := 0;

    for i := 0 to PeriodoTWAP - 1 do
    begin
        somaPreco := somaPreco + Close[i];
    end;

    twapValue := somaPreco / PeriodoTWAP;

    // GAP institucional
    gap := vwapValue - twapValue;

    // PLOTS
    Plot(vwapValue);        // Plot1
    Plot2(twapValue);       // Plot2
    Plot3(gap);             // Plot3 (histograma depois)

    // Coloração do GAP
    if gap > 0 then
        SetPlotColor(3, clRed)
    else
        SetPlotColor(3, clGreen);
end;
