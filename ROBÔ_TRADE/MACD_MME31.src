INPUT
periodo_curto(7);        // MACD curto
periodo_longo(31);       // MACD longo
periodo_sinal(3);        // MACD sinal
periodo_mme(31);         // MME que será comparada com o MACD

VAR
macd_linha, macd_sinal, macd_hist : real;
mme31 : real;
sinal_compra, sinal_venda : booleano;
heikinCorVerde, heikinCorVermelha : booleano;

BEGIN

// Calcular MACD
macd_linha := MediaExp(Close, periodo_curto) - MediaExp(Close, periodo_longo);
macd_sinal := MediaExp(macd_linha, periodo_sinal);
macd_hist := macd_linha - macd_sinal;

// Calcular MME 31 sobre o preço
mme31 := MediaExp(Close, periodo_mme);

// Verificar cor da vela Heikin Ashi
heikinCorVerde := (Close > Open);
heikinCorVermelha := (Close < Open);

// Sinais com confirmação visual
sinal_compra := (macd_linha > mme31) and (macd_linha[1] <= mme31[1]) and heikinCorVerde;
sinal_venda  := (macd_linha < mme31) and (macd_linha[1] >= mme31[1]) and heikinCorVermelha;

// Entradas
se sinal_compra e (not IsBought) e (not IsSold) entao BuyAtMarket;
se sinal_venda  e (not IsBought) e (not IsSold) entao SellShortAtMarket;

// Saídas
se IsBought e sinal_venda entao ClosePosition;
se IsSold e sinal_compra entao ClosePosition;

// Plotagem
plot(macd_linha);       // MACD linha
plot2(macd_sinal);      // MACD sinal
plot3(macd_hist);       // Histograma MACD
plot4(mme31);           // MME 31

END;

