// Método inspirado no Método de Joseph Reffson (MeJoRe)(Newton–Raphson)
// Versão 01, experimentos.
input
  offset(20);
  //Heikin Ashi
  PeriodoHA(9);
  // DE 1 A 9
  TipoHA(1);
  // 0 - Aritmética | 1 - Exponencial | 2 - Welles Wilder | 3 - Ponderada
  //DadoHA    (1); // 1 - Fechamento | 0 - Abertura    | 2 - Máxima        | 3 - Mínima
  PrecoPassadoHAClose(15);
  //Banda Rápida/Leve | Posição do Candle.
  PrecoPassadoHAOpen(3);
  //Banda Lenta/Pesada  | Posição do Candle.
  //RenkoVTwo Periodo : Integer, Abertura : Float, Deslocamento : Integer)|Linha : Integer|
  RenkoVTwoPeriodo(3);
  RenkoVTwoAbertura(1);
  //1.5 é o Padrão.
  RenkoVTwoDeslocamento(0);
  //0 é o Padrão.
  RenkoVTwoLinhaMais(0);
  //|0| - Linha RenkoV2+
  RenkoVTwoLinhaMenos(1);
  //|1| - Linha RenkoV2-
var
  mm,vlrStopC,vlrStopV     : real; //real;
  sinalC,sinalV            : booleano;
  
  //3 VWAPS / TRIWAP:
  vVWAPd                   : real;
  vVWAPs                   : real;
  vVWAPm                   : real;
  vTRIWAP                  : real;
  // 4. INDICADOR HEIKIN ASHI
  HA_Close                 : float;
  HA_Open                  : float;
  HA_High                  : float;
  HA_Low                   : float;
  vHeikinAshiClose         : float;
  vHeikinAshiOpen          : float;
  vHeikinAshiMedia         : float;
  vTRIWAPvHeikinAshiClose  : float;
  vTRIWAPvHeikinAshiOpen   : float;
  vTRIWAPHeikinAshiMedia   : float;
  vOuro                    : float;
  vOuroPreto               : float;
  vOuroBranco              : float;
  vrenkoV2mais             : float;
  vrenkoV2menos            : float;
  vrenkoV2media            : float;
  vrenkoV2mediavTRIWAP     : float;
  vAskPrice                : float;
  vBidPrice                : float;
  vPriceMedia              : float;
  vPriceMediavTRIWAP       : float;
  vrenkoV2mediavPriceMedia : float;
  vAvgPrice                : float;
  vPTAX                    : inteiro;
  //VARIÁVEIS DE ESTRATÉDIA DE ENTRADA:
  vEtrategia               : float;
  //VARIÁVEIS DE SAÍDA:
begin
  // PASSO 1 | CARREGAR INDICADORES
  mm := MediaExp(9,close);
  //VWAPS
  vVWAPd := VWAP(1);
  vVWAPs := VWAP(2);
  vVWAPm := VWAP(3);
  vTRIWAP := (vVWAPd + vVWAPs + vVWAPm) / 3;
  // 1. MÉDIA DAS VWAP´S
  //HeikinAshi(Media : Integer,     TipoMedia : Integer)  |Dado : Integer|
  // PeriodoHA: // TipoHA:           // DadoHA:
  HA_Close := HeikinAshi(PeriodoHA,TipoHA)|1|;
  // DE 1 A 9   // 0 - Aritmética    // |1| - Fechamento
  HA_Open := HeikinAshi(PeriodoHA,TipoHA)|0|;
  // DE 1 A 9   // 1 - Exponencial   // |0| - Abertura
  HA_High := HeikinAshi(PeriodoHA,TipoHA)|2|;
  // DE 1 A 9   // 2 - Welles Wilder // |2| - Máxima
  HA_Low := HeikinAshi(PeriodoHA,TipoHA)|3|;
  // DE 1 A 9   // 3 - Ponderada     // |3| - Mínima
  vHeikinAshiClose := (HA_Close[PrecoPassadoHAClose] + HA_Open[PrecoPassadoHAClose] + HA_High[PrecoPassadoHAClose] + HA_Low[PrecoPassadoHAClose]) / 4;
  // 5. MÉDIA DAS MÉDIAS DE HEIKIN ASHI | VERMELHA
  vHeikinAshiOpen := (HA_Close[PrecoPassadoHAOpen] + HA_Open[PrecoPassadoHAOpen]) / 2;
  // 5. MÉDIA DAS MÉDIAS DE HEIKIN ASHI | VERDE
  vHeikinAshiMedia := (vHeikinAshiClose + vHeikinAshiOpen) / 2;
  // vVolatilidadeHistorica; | AMARELA
  vTRIWAPvHeikinAshiClose := (vTRIWAP + vHeikinAshiClose) / 2;
  vTRIWAPvHeikinAshiOpen := (vTRIWAP + vHeikinAshiOpen) / 2;
  vTRIWAPHeikinAshiMedia := (vTRIWAP + vHeikinAshiMedia) / 2;
  vOuro := (vHeikinAshiMedia + vTRIWAPHeikinAshiMedia) / 2;
  vOuroPreto := (vOuro + vHeikinAshiClose + vHeikinAshiOpen) / 3;
  vOuroBranco := (vOuro + vTRIWAPvHeikinAshiClose + vTRIWAPHeikinAshiMedia) / 3;
  vrenkoV2mais := RenkoVTwo(RenkoVTwoPeriodo,RenkoVTwoAbertura,RenkoVTwoDeslocamento)|0|;   //|0| - Linha RenkoV2+
  vrenkoV2menos := RenkoVTwo(RenkoVTwoPeriodo,RenkoVTwoAbertura,RenkoVTwoDeslocamento)|1|;  //|1| - Linha RenkoV2-
  vrenkoV2media := (vrenkoV2mais + vrenkoV2menos) / 2;
  vrenkoV2mediavTRIWAP := (vrenkoV2media + vTRIWAP) / 2;
  vAskPrice := AskPrice;
  //AskPrice retorna o preço da melhor oferta de venda.
  vBidPrice := BidPrice;
  //BidPrice retorna o preço da melhor oferta de compra.
  vPriceMedia := (vAskPrice + vBidPrice) / 2;
  vPriceMediavTRIWAP := (vPriceMedia + vTRIWAP) / 2;
  vrenkoV2mediavPriceMedia := (vrenkoV2media + vPriceMedia) / 2;
  vAvgPrice := AvgPrice;

  vEtrategia := vAvgPrice;

  //vPTAX := PTAX;
  //-----------PADRÃO----------
  //EXECUÇÃO DE ENTRADA //PASSO 2 | SINAIS DE ENTRADA
  //sinalC :=(mm[2] > mm[1]) e (mm[1] < mm[0]);
  //sinalV :=(mm[2] < mm[1]) e (mm[1] > mm[0]);
  sinalC := (vEtrategia[2] > vEtrategia[1]) e (vEtrategia[1] < vEtrategia[0]);
  sinalV := (vEtrategia[2] < vEtrategia[1]) e (vEtrategia[1] > vEtrategia[0]);
  //EXECUCAO DE ENTRADA
  se ( not HasPosition) e sinalC entao
    BuyStop((maxima[0] + MinPriceIncrement),(maxima[0] + MinPriceIncrement) + (offSet * MinPriceIncrement));
  se ( not HasPosition) e sinalV entao
    SellShortStop((minima[0] - MinPriceIncrement),(minima[0] - MinPriceIncrement) - (offSet * MinPriceIncrement));
  //EXECUÇÃO DE SAÍDA //PASSO 3 | SINAIS DE SAÍDA //EXECUCAO DA SAIDA
  //vlrStopC := minima[0];
  //vlrStopV := maxima[0];
  
  //EM TESTE 1
  vlrStopC := (vEtrategia[0]);   
  vlrStopV := (vEtrategia[0]);

  se IsBought entao
    SellToCoverStop(vlrStopC,vlrStopC - (offSet * MinPriceIncrement));
  se IsSold entao
    BuyToCoverStop(vlrStopV,vlrStopv + (offSet * MinPriceIncrement));
  //EXECUCAO DE SAIDA EM GAP
  se IsBought e (close < vlrStopC) entao
    closeposition;
  se IsSold e (close > vlrStopV) entao
    closeposition;
  //COLORAÇÃO
  SetPlotColor(1,clVermelho);
  // vTRIWAP, VERMELHO
  SetPlotColor(2,clVermelho);
  // vHeikinAshiClose, VERMELHO
  SetPlotColor(3,clVerde);
  // vHeikinAshiMedia, AMARELO
  SetPlotColor(4,clVerde);
  // vHeikinAshiOpen, VERDE
  SetPlotColor(5,clVermelho);
  // vTRIWAPvHeikinAshiClose, VERMELHO
  SetPlotColor(6,clVermelho);
  // vTRIWAPHeikinAshiMedia, AMARELO
  SetPlotColor(7,clVerde);
  // vTRIWAPvHeikinAshiOpen, VERDE
  SetPlotColor(8,clAmarelo);
  // vOuro, VERDE LIMÃO
  SetPlotColor(9,clBlack);
  // vOuroPreto, Preto
  SetPlotColor(10,clBranco);
  // vOuroPreto, Preto
  SetPlotColor(11,clBranco);
  // vOuroPreto, Preto
  SetPlotColor(16,clAzul);
  //ESPESSURA
  SetPlotWidth(1,5);
  // 1. MÉDIA DAS VWAP´S
  SetPlotWidth(2,5);
  // 2. MÉDIA DAS MÉDIAS.
  SetPlotWidth(3,3);
  // 3. MÉDIA MÓVEL: entre Abertura, Fechamento, Máxima e Mínima - AvgPrice
  SetPlotWidth(4,1);
  // 4. INDICADOR HEIKIN ASHI
  SetPlotWidth(5,5);
  SetPlotWidth(6,3);
  SetPlotWidth(7,1);
  SetPlotWidth(8,5);
  SetPlotWidth(9,5);
  SetPlotWidth(10,5);
  SetPlotWidth(11,3);
  SetPlotWidth(16,3);
  //ESTILO DA LINHA
  SetPlotStyle(1,2);
  // 1. MÉDIA DAS VWAP´S
  SetPlotStyle(2,0);
  // 2. MÉDIA DAS MÉDIAS.
  SetPlotStyle(3,0);
  // 3. MÉDIA MÓVEL: entre Abertura, Fechamento, Máxima e Mínima - AvgPrice
  SetPlotStyle(4,0);
  // 4. INDICADOR HEIKIN ASHI
  SetPlotStyle(5,0);
  SetPlotStyle(6,0);
  SetPlotStyle(7,0);
  SetPlotStyle(8,0);
  SetPlotStyle(9,0);
  SetPlotStyle(10,0);
  SetPlotStyle(11,0);
  //PLOTAGEM
  //Plot  (vTRIWAP);                 // vTRIWAP, VERMELHO
  ///Plot2 (vHeikinAshiClose);        // vHeikinAshiClose, VERMELHO
  ///Plot3 (vHeikinAshiMedia);          // vHeikinAshiMedia, AMARELO
  //Plot4 (vHeikinAshiOpen);         // vHeikinAshiOpen, VERDE
  //Plot5 (vTRIWAPvHeikinAshiClose); // vTRIWAPvHeikinAshiClose, VERMELHO
  //Plot6 (vTRIWAPHeikinAshiMedia);    // vTRIWAPHeikinAshiMedia, AMARELO
  //Plot7 (vTRIWAPvHeikinAshiOpen);  // vTRIWAPvHeikinAshiOpen, VERDE
  ///Plot8 (vOuro);                     // vOuro, VERDE LIMÃO
  ///Plot9 (vOuroPreto);                // vOuroPreto, Preto
  //Plot10 (vOuroBranco);
  //Plot11 (vrenkoV2media); //Brancona
  //Plot12 (vrenkoV2mediavTRIWAP);
  //Plot15 (vPriceMedia); //*
  //Plot16 (vPriceMediavTRIWAP);
  //Plot17 (vrenkoV2mediavPriceMedia);
  Plot16(vAvgPrice);
end;
