// ============================================================================
// BRICKMASTER V14_versao4_GROK

// NOME NO CLAUDE: BRICKMASTER_V14_GROK
// NOME NO PROFIT: CAR_1CENTO_v14_v4_GROK

// ----------------------------------------------------------------------------
// Autor original : Carlos Andrade
// Recriação     : Grok (xAI) — 13/09/2026
// Plataforma    : Profit / Nelogica — CARREGAR COMO ESTRATÉGIA
// Linguagem     : NTSL (Manual v4.2)
// ----------------------------------------------------------------------------
// VERSÃO: V14_versao4
// Módulos inclusos:
//   00 - Base (Bandas + Médias + Abertura)          → CONCLUÍDO
//   01 - Ciclo de Eventos das Bandas                → CONCLUÍDO
//   02 - PaintBar (Cores)                           → CONCLUÍDO
//   03 - Score + Contexto                           → CONCLUÍDO
//   04 - Aceitação / Rejeição da Abertura           → NOVO
//
// Módulo 04:
//   - Trata a Abertura do Dia como "banda zero"
//   - Só é válido se o preço já tocou ±Meio no mesmo dia
//   - Aceitação (virada de lado) e Rejeição (reteste)
//   - Peso máximo no Score (+3)
//   - Prioridade máxima no PaintBar (P0)
//   - Somente leitura (não gera ordem)
// ============================================================================

input
  // --- Bandas percentuais ---
  PercentualMeio(0.50);
  PercentualAlvo1(1.00);
  PercentualAlvo2(2.00);
  PercentualAlvo3(3.00);

  // --- Médias de variação das bandas ---
  PeriodoMediaBandasCurta(9);
  PeriodoMediaBandasLonga(25);

  // --- Controles de plotagem ---
  MostrarAbertura(true);
  MostrarMeio(true);
  MostrarAlvo1(true);
  MostrarAlvo2(true);
  MostrarAlvo3(true);
  MostrarMediaCurta(true);
  MostrarMediaLonga(true);
  PintarCandles(true);

  // --- Filtros do ciclo de eventos ---
  MinPavioRejeicao(0.40);
  MinPavioArmadilha(0.55);

  // --- Score + Contexto ---
  DiferencaMinimaScore(3.0);
  PesoConfirmacaoArmadilha1(2.0);
  PesoConfirmacaoArmadilhaOutros(1.5);
  PesoConfirmacaoRejeicao1(1.5);
  PesoArmadilha1(1.0);
  PesoRejeicao1(0.7);
  PesoAceitacao1(0.8);
  PesoEventosSecundarios(0.5);
  PesoAbertura(3.0);                 // Peso máximo — Aceitação/Rejeição da Abertura

var
  // Controle de novo dia
  NovoDia                   : Boolean;
  AberturaDia               : Float;
  BarrasDoDia               : Integer;

  // Bandas
  LinhaMaisMeio             : Float;
  LinhaMenosMeio            : Float;
  LinhaMais1                : Float;
  LinhaMenos1               : Float;
  LinhaMais2                : Float;
  LinhaMenos2               : Float;
  LinhaMais3                : Float;
  LinhaMenos3               : Float;

  // Variação e médias
  VariacaoAtual             : Float;
  SomaVariacaoCurta         : Float;
  SomaVariacaoLonga         : Float;
  MediaVariacaoBandasCurta  : Float;
  MediaVariacaoBandasLonga  : Float;
  MediaBandasCurta          : Float;
  MediaBandasLonga          : Float;
  i                         : Integer;
  PeriodoEfetivoCurta       : Integer;
  PeriodoEfetivoLonga       : Integer;

  // Características do candle
  Corpo                     : Float;
  RangeCandle               : Float;
  PavioSuperior             : Float;
  PavioInferior             : Float;
  CandleAlta                : Boolean;
  CandleBaixa               : Boolean;
  PctPavioSuperior          : Float;
  PctPavioInferior          : Float;

  // ========== CICLO DE EVENTOS — ±0,50% ==========
  TocouMaisMeio             : Boolean;
  TocouMenosMeio            : Boolean;
  AceitouMaisMeio           : Boolean;
  AceitouMenosMeio          : Boolean;
  RejeitouMaisMeio          : Boolean;
  RejeitouMenosMeio         : Boolean;
  ArmadilhaMaisMeio         : Boolean;
  ArmadilhaMenosMeio        : Boolean;
  ConfirmouRejeicaoMaisMeio : Boolean;
  ConfirmouRejeicaoMenosMeio: Boolean;
  ConfirmouArmadilhaMaisMeio: Boolean;
  ConfirmouArmadilhaMenosMeio: Boolean;

  // ========== CICLO DE EVENTOS — ±1% ==========
  TocouMais1                : Boolean;
  TocouMenos1               : Boolean;
  AceitouMais1              : Boolean;
  AceitouMenos1             : Boolean;
  RejeitouMais1             : Boolean;
  RejeitouMenos1            : Boolean;
  ArmadilhaMais1            : Boolean;
  ArmadilhaMenos1           : Boolean;
  ConfirmouRejeicaoMais1    : Boolean;
  ConfirmouRejeicaoMenos1   : Boolean;
  ConfirmouArmadilhaMais1   : Boolean;
  ConfirmouArmadilhaMenos1  : Boolean;

  // ========== CICLO DE EVENTOS — ±2% ==========
  TocouMais2                : Boolean;
  TocouMenos2               : Boolean;
  AceitouMais2              : Boolean;
  AceitouMenos2             : Boolean;
  RejeitouMais2             : Boolean;
  RejeitouMenos2            : Boolean;
  ArmadilhaMais2            : Boolean;
  ArmadilhaMenos2           : Boolean;
  ConfirmouRejeicaoMais2    : Boolean;
  ConfirmouRejeicaoMenos2   : Boolean;
  ConfirmouArmadilhaMais2   : Boolean;
  ConfirmouArmadilhaMenos2  : Boolean;

  // ========== CICLO DE EVENTOS — ±3% ==========
  TocouMais3                : Boolean;
  TocouMenos3               : Boolean;
  AceitouMais3              : Boolean;
  AceitouMenos3             : Boolean;
  RejeitouMais3             : Boolean;
  RejeitouMenos3            : Boolean;
  ArmadilhaMais3            : Boolean;
  ArmadilhaMenos3           : Boolean;
  ConfirmouRejeicaoMais3    : Boolean;
  ConfirmouRejeicaoMenos3   : Boolean;
  ConfirmouArmadilhaMais3   : Boolean;
  ConfirmouArmadilhaMenos3  : Boolean;

  // Controle de PaintBar
  PintouEvento              : Boolean;

  // ========== SCORE + CONTEXTO ==========
  ScoreComprador            : Float;
  ScoreVendedor             : Float;
  DiferencaScore            : Float;
  ContextoComprador         : Boolean;
  ContextoVendedor          : Boolean;
  ContextoNeutro            : Boolean;
  DiaDirecionalCompra       : Boolean;
  DiaDirecionalVenda        : Boolean;

  // ========== MÓDULO 04 — ACEITAÇÃO / REJEIÇÃO DA ABERTURA ==========
  TocouMaisMeioHoje         : Boolean;
  TocouMenosMeioHoje        : Boolean;
  PrecoAcimaAbertura        : Boolean;
  PrecoAbaixoAbertura       : Boolean;
  CruzouAberturaParaCima    : Boolean;
  CruzouAberturaParaBaixo   : Boolean;
  AceitacaoAberturaCompra   : Boolean;   // Virada para cima (aceitação compradora)
  AceitacaoAberturaVenda    : Boolean;   // Virada para baixo (aceitação vendedora)
  RejeicaoAberturaCompra    : Boolean;   // Reteste da abertura confirmando compra
  RejeicaoAberturaVenda     : Boolean;   // Reteste da abertura confirmando venda
  ConfirmouAceitacaoAberturaCompra : Boolean;
  ConfirmouAceitacaoAberturaVenda  : Boolean;
  ConfirmouRejeicaoAberturaCompra  : Boolean;
  ConfirmouRejeicaoAberturaVenda   : Boolean;

begin
  // ========================================================================
  // 1. DETECÇÃO DE NOVO DIA E CAPTURA DA ABERTURA
  // ========================================================================
  NovoDia := (Date <> Date[1]);

  if NovoDia then
  begin
    AberturaDia         := Open;
    BarrasDoDia         := 1;
    SomaVariacaoCurta   := 0;
    SomaVariacaoLonga   := 0;
    ScoreComprador      := 0;
    ScoreVendedor       := 0;
    TocouMaisMeioHoje   := false;
    TocouMenosMeioHoje  := false;
  end
  else
    BarrasDoDia := BarrasDoDia + 1;

  if AberturaDia > 0 then
  begin
    // ========================================================================
    // 2. CÁLCULO DAS 8 BANDAS
    // ========================================================================
    LinhaMaisMeio  := AberturaDia * (1 + PercentualMeio  / 100);
    LinhaMenosMeio := AberturaDia * (1 - PercentualMeio  / 100);
    LinhaMais1     := AberturaDia * (1 + PercentualAlvo1 / 100);
    LinhaMenos1    := AberturaDia * (1 - PercentualAlvo1 / 100);
    LinhaMais2     := AberturaDia * (1 + PercentualAlvo2 / 100);
    LinhaMenos2    := AberturaDia * (1 - PercentualAlvo2 / 100);
    LinhaMais3     := AberturaDia * (1 + PercentualAlvo3 / 100);
    LinhaMenos3    := AberturaDia * (1 - PercentualAlvo3 / 100);

    // ========================================================================
    // 3. VARIAÇÃO + MÉDIAS
    // ========================================================================
    VariacaoAtual := ((Close - AberturaDia) / AberturaDia) * 100;

    if BarrasDoDia <= PeriodoMediaBandasCurta then
      PeriodoEfetivoCurta := BarrasDoDia
    else
      PeriodoEfetivoCurta := PeriodoMediaBandasCurta;

    SomaVariacaoCurta := 0;
    for i := 0 to PeriodoEfetivoCurta - 1 do
      SomaVariacaoCurta := SomaVariacaoCurta + VariacaoAtual[i];

    if PeriodoEfetivoCurta > 0 then
      MediaVariacaoBandasCurta := SomaVariacaoCurta / PeriodoEfetivoCurta
    else
      MediaVariacaoBandasCurta := 0;

    MediaBandasCurta := AberturaDia * (1 + MediaVariacaoBandasCurta / 100);

    if BarrasDoDia <= PeriodoMediaBandasLonga then
      PeriodoEfetivoLonga := BarrasDoDia
    else
      PeriodoEfetivoLonga := PeriodoMediaBandasLonga;

    SomaVariacaoLonga := 0;
    for i := 0 to PeriodoEfetivoLonga - 1 do
      SomaVariacaoLonga := SomaVariacaoLonga + VariacaoAtual[i];

    if PeriodoEfetivoLonga > 0 then
      MediaVariacaoBandasLonga := SomaVariacaoLonga / PeriodoEfetivoLonga
    else
      MediaVariacaoBandasLonga := 0;

    MediaBandasLonga := AberturaDia * (1 + MediaVariacaoBandasLonga / 100);

    // ========================================================================
    // 4. CARACTERÍSTICAS DO CANDLE
    // ========================================================================
    if Close >= Open then
    begin
      CandleAlta    := true;
      CandleBaixa   := false;
      Corpo         := Close - Open;
      PavioSuperior := High - Close;
      PavioInferior := Open - Low;
    end
    else
    begin
      CandleAlta    := false;
      CandleBaixa   := true;
      Corpo         := Open - Close;
      PavioSuperior := High - Open;
      PavioInferior := Close - Low;
    end;

    RangeCandle := High - Low;
    if RangeCandle > 0 then
    begin
      PctPavioSuperior := PavioSuperior / RangeCandle;
      PctPavioInferior := PavioInferior / RangeCandle;
    end
    else
    begin
      PctPavioSuperior := 0;
      PctPavioInferior := 0;
    end;

    // ========================================================================
    // 5. CICLO DE EVENTOS — ±0,50% / ±1% / ±2% / ±3%
    // ========================================================================
    TocouMaisMeio  := (High >= LinhaMaisMeio);
    TocouMenosMeio := (Low  <= LinhaMenosMeio);
    AceitouMaisMeio  := (Close > LinhaMaisMeio);
    AceitouMenosMeio := (Close < LinhaMenosMeio);
    RejeitouMaisMeio  := TocouMaisMeio  and (Close < LinhaMaisMeio)  and (PctPavioSuperior >= MinPavioRejeicao);
    RejeitouMenosMeio := TocouMenosMeio and (Close > LinhaMenosMeio) and (PctPavioInferior  >= MinPavioRejeicao);
    ArmadilhaMaisMeio  := RejeitouMaisMeio  and (PctPavioSuperior >= MinPavioArmadilha);
    ArmadilhaMenosMeio := RejeitouMenosMeio and (PctPavioInferior  >= MinPavioArmadilha);
    ConfirmouArmadilhaMaisMeio  := ArmadilhaMaisMeio  and CandleBaixa;
    ConfirmouArmadilhaMenosMeio := ArmadilhaMenosMeio and CandleAlta;
    ConfirmouRejeicaoMaisMeio   := RejeitouMaisMeio   and CandleBaixa and (not ArmadilhaMaisMeio);
    ConfirmouRejeicaoMenosMeio  := RejeitouMenosMeio  and CandleAlta  and (not ArmadilhaMenosMeio);

    TocouMais1  := (High >= LinhaMais1);
    TocouMenos1 := (Low  <= LinhaMenos1);
    AceitouMais1  := (Close > LinhaMais1);
    AceitouMenos1 := (Close < LinhaMenos1);
    RejeitouMais1  := TocouMais1  and (Close < LinhaMais1)  and (PctPavioSuperior >= MinPavioRejeicao);
    RejeitouMenos1 := TocouMenos1 and (Close > LinhaMenos1) and (PctPavioInferior  >= MinPavioRejeicao);
    ArmadilhaMais1  := RejeitouMais1  and (PctPavioSuperior >= MinPavioArmadilha);
    ArmadilhaMenos1 := RejeitouMenos1 and (PctPavioInferior  >= MinPavioArmadilha);
    ConfirmouArmadilhaMais1  := ArmadilhaMais1  and CandleBaixa;
    ConfirmouArmadilhaMenos1 := ArmadilhaMenos1 and CandleAlta;
    ConfirmouRejeicaoMais1   := RejeitouMais1   and CandleBaixa and (not ArmadilhaMais1);
    ConfirmouRejeicaoMenos1  := RejeitouMenos1  and CandleAlta  and (not ArmadilhaMenos1);

    TocouMais2  := (High >= LinhaMais2);
    TocouMenos2 := (Low  <= LinhaMenos2);
    AceitouMais2  := (Close > LinhaMais2);
    AceitouMenos2 := (Close < LinhaMenos2);
    RejeitouMais2  := TocouMais2  and (Close < LinhaMais2)  and (PctPavioSuperior >= MinPavioRejeicao);
    RejeitouMenos2 := TocouMenos2 and (Close > LinhaMenos2) and (PctPavioInferior  >= MinPavioRejeicao);
    ArmadilhaMais2  := RejeitouMais2  and (PctPavioSuperior >= MinPavioArmadilha);
    ArmadilhaMenos2 := RejeitouMenos2 and (PctPavioInferior  >= MinPavioArmadilha);
    ConfirmouArmadilhaMais2  := ArmadilhaMais2  and CandleBaixa;
    ConfirmouArmadilhaMenos2 := ArmadilhaMenos2 and CandleAlta;
    ConfirmouRejeicaoMais2   := RejeitouMais2   and CandleBaixa and (not ArmadilhaMais2);
    ConfirmouRejeicaoMenos2  := RejeitouMenos2  and CandleAlta  and (not ArmadilhaMenos2);

    TocouMais3  := (High >= LinhaMais3);
    TocouMenos3 := (Low  <= LinhaMenos3);
    AceitouMais3  := (Close > LinhaMais3);
    AceitouMenos3 := (Close < LinhaMenos3);
    RejeitouMais3  := TocouMais3  and (Close < LinhaMais3)  and (PctPavioSuperior >= MinPavioRejeicao);
    RejeitouMenos3 := TocouMenos3 and (Close > LinhaMenos3) and (PctPavioInferior  >= MinPavioRejeicao);
    ArmadilhaMais3  := RejeitouMais3  and (PctPavioSuperior >= MinPavioArmadilha);
    ArmadilhaMenos3 := RejeitouMenos3 and (PctPavioInferior  >= MinPavioArmadilha);
    ConfirmouArmadilhaMais3  := ArmadilhaMais3  and CandleBaixa;
    ConfirmouArmadilhaMenos3 := ArmadilhaMenos3 and CandleAlta;
    ConfirmouRejeicaoMais3   := RejeitouMais3   and CandleBaixa and (not ArmadilhaMais3);
    ConfirmouRejeicaoMenos3  := RejeitouMenos3  and CandleAlta  and (not ArmadilhaMenos3);

    // Atualiza flags de toque do Meio no dia
    if TocouMaisMeio then
      TocouMaisMeioHoje := true;
    if TocouMenosMeio then
      TocouMenosMeioHoje := true;

    // ========================================================================
    // 6. MÓDULO 04 — ACEITAÇÃO / REJEIÇÃO DA ABERTURA
    // ========================================================================
    // Só é válido se o preço já tocou ±Meio no mesmo dia (gate obrigatório).
    // Aceitação = cruzamento da abertura na direção da virada.
    // Rejeição  = toque na abertura + fechamento confirmando o lado atual.

    PrecoAcimaAbertura  := (Close > AberturaDia);
    PrecoAbaixoAbertura := (Close < AberturaDia);

    CruzouAberturaParaCima  := (Close > AberturaDia) and (Close[1] <= AberturaDia);
    CruzouAberturaParaBaixo := (Close < AberturaDia) and (Close[1] >= AberturaDia);

    // Aceitação (virada de lado) — requer toque prévio do Meio
    AceitacaoAberturaCompra := CruzouAberturaParaCima  and TocouMenosMeioHoje;
    AceitacaoAberturaVenda  := CruzouAberturaParaBaixo and TocouMaisMeioHoje;

    // Rejeição (reteste da abertura confirmando direção)
    // Tocou a abertura (pavio) e fechou do mesmo lado do movimento
    RejeicaoAberturaCompra := (Low <= AberturaDia) and (Close > AberturaDia) and
                              TocouMaisMeioHoje and CandleAlta and
                              (PctPavioInferior >= MinPavioRejeicao);

    RejeicaoAberturaVenda  := (High >= AberturaDia) and (Close < AberturaDia) and
                              TocouMenosMeioHoje and CandleBaixa and
                              (PctPavioSuperior >= MinPavioRejeicao);

    // Confirmação em 2 candles (versão simples: o evento + candle seguinte na mesma direção)
    ConfirmouAceitacaoAberturaCompra := AceitacaoAberturaCompra[1] and CandleAlta and PrecoAcimaAbertura;
    ConfirmouAceitacaoAberturaVenda  := AceitacaoAberturaVenda[1]  and CandleBaixa and PrecoAbaixoAbertura;
    ConfirmouRejeicaoAberturaCompra  := RejeicaoAberturaCompra[1]  and CandleAlta and PrecoAcimaAbertura;
    ConfirmouRejeicaoAberturaVenda   := RejeicaoAberturaVenda[1]   and CandleBaixa and PrecoAbaixoAbertura;

    // ========================================================================
    // 7. SCORE + CONTEXTO (incluindo peso da Abertura)
    // ========================================================================
    // Confirmação Armadilha ±1%
    if ConfirmouArmadilhaMenos1 and (not ConfirmouArmadilhaMenos1[1]) then
      ScoreComprador := ScoreComprador + PesoConfirmacaoArmadilha1;
    if ConfirmouArmadilhaMais1 and (not ConfirmouArmadilhaMais1[1]) then
      ScoreVendedor  := ScoreVendedor  + PesoConfirmacaoArmadilha1;

    // Confirmação Armadilha outras bandas
    if ConfirmouArmadilhaMenosMeio and (not ConfirmouArmadilhaMenosMeio[1]) then
      ScoreComprador := ScoreComprador + PesoConfirmacaoArmadilhaOutros;
    if ConfirmouArmadilhaMenos2 and (not ConfirmouArmadilhaMenos2[1]) then
      ScoreComprador := ScoreComprador + PesoConfirmacaoArmadilhaOutros;
    if ConfirmouArmadilhaMenos3 and (not ConfirmouArmadilhaMenos3[1]) then
      ScoreComprador := ScoreComprador + PesoConfirmacaoArmadilhaOutros;
    if ConfirmouArmadilhaMaisMeio and (not ConfirmouArmadilhaMaisMeio[1]) then
      ScoreVendedor  := ScoreVendedor  + PesoConfirmacaoArmadilhaOutros;
    if ConfirmouArmadilhaMais2 and (not ConfirmouArmadilhaMais2[1]) then
      ScoreVendedor  := ScoreVendedor  + PesoConfirmacaoArmadilhaOutros;
    if ConfirmouArmadilhaMais3 and (not ConfirmouArmadilhaMais3[1]) then
      ScoreVendedor  := ScoreVendedor  + PesoConfirmacaoArmadilhaOutros;

    // Confirmação Rejeição ±1%
    if ConfirmouRejeicaoMenos1 and (not ConfirmouRejeicaoMenos1[1]) then
      ScoreComprador := ScoreComprador + PesoConfirmacaoRejeicao1;
    if ConfirmouRejeicaoMais1 and (not ConfirmouRejeicaoMais1[1]) then
      ScoreVendedor  := ScoreVendedor  + PesoConfirmacaoRejeicao1;

    // Armadilha / Rejeição / Aceitação ±1%
    if ArmadilhaMenos1 and (not ArmadilhaMenos1[1]) and (not ConfirmouArmadilhaMenos1) then
      ScoreComprador := ScoreComprador + PesoArmadilha1;
    if ArmadilhaMais1 and (not ArmadilhaMais1[1]) and (not ConfirmouArmadilhaMais1) then
      ScoreVendedor  := ScoreVendedor  + PesoArmadilha1;
    if RejeitouMenos1 and (not RejeitouMenos1[1]) and (not ConfirmouRejeicaoMenos1) and (not ArmadilhaMenos1) then
      ScoreComprador := ScoreComprador + PesoRejeicao1;
    if RejeitouMais1 and (not RejeitouMais1[1]) and (not ConfirmouRejeicaoMais1) and (not ArmadilhaMais1) then
      ScoreVendedor  := ScoreVendedor  + PesoRejeicao1;
    if AceitouMenos1 and (not AceitouMenos1[1]) then
      ScoreVendedor  := ScoreVendedor  + PesoAceitacao1;
    if AceitouMais1 and (not AceitouMais1[1]) then
      ScoreComprador := ScoreComprador + PesoAceitacao1;

    // Eventos secundários
    if (ArmadilhaMenosMeio or ArmadilhaMenos2 or ArmadilhaMenos3) and
       (not (ArmadilhaMenosMeio[1] or ArmadilhaMenos2[1] or ArmadilhaMenos3[1])) then
      ScoreComprador := ScoreComprador + PesoEventosSecundarios;
    if (ArmadilhaMaisMeio or ArmadilhaMais2 or ArmadilhaMais3) and
       (not (ArmadilhaMaisMeio[1] or ArmadilhaMais2[1] or ArmadilhaMais3[1])) then
      ScoreVendedor  := ScoreVendedor  + PesoEventosSecundarios;

    // --- Peso da Abertura (máximo do sistema) ---
    if ConfirmouAceitacaoAberturaCompra and (not ConfirmouAceitacaoAberturaCompra[1]) then
      ScoreComprador := ScoreComprador + PesoAbertura;
    if ConfirmouAceitacaoAberturaVenda and (not ConfirmouAceitacaoAberturaVenda[1]) then
      ScoreVendedor  := ScoreVendedor  + PesoAbertura;
    if ConfirmouRejeicaoAberturaCompra and (not ConfirmouRejeicaoAberturaCompra[1]) then
      ScoreComprador := ScoreComprador + PesoAbertura;
    if ConfirmouRejeicaoAberturaVenda and (not ConfirmouRejeicaoAberturaVenda[1]) then
      ScoreVendedor  := ScoreVendedor  + PesoAbertura;

    // Contexto
    DiferencaScore := ScoreComprador - ScoreVendedor;
    ContextoComprador := (DiferencaScore >= DiferencaMinimaScore);
    ContextoVendedor  := (DiferencaScore <= -DiferencaMinimaScore);
    ContextoNeutro    := (not ContextoComprador) and (not ContextoVendedor);
    DiaDirecionalCompra := ContextoComprador and (DiferencaScore >= (DiferencaMinimaScore * 1.5));
    DiaDirecionalVenda  := ContextoVendedor  and (DiferencaScore <= -(DiferencaMinimaScore * 1.5));

    // ========================================================================
    // 8. PLOTAGEM DAS LINHAS
    // ========================================================================
    if MostrarAbertura then
    begin
      Plot(AberturaDia);
      SetPlotColor(1, RGB(255, 255, 255));
      SetPlotWidth(1, 2);
    end;

    if MostrarMeio then
    begin
      Plot2(LinhaMaisMeio);
      SetPlotColor(2, RGB(180, 180, 50));
      Plot3(LinhaMenosMeio);
      SetPlotColor(3, RGB(180, 180, 50));
    end;

    if MostrarAlvo1 then
    begin
      Plot4(LinhaMais1);
      SetPlotColor(4, RGB(0, 180, 255));
      Plot5(LinhaMenos1);
      SetPlotColor(5, RGB(0, 180, 255));
    end;

    if MostrarAlvo2 then
    begin
      Plot6(LinhaMais2);
      SetPlotColor(6, RGB(0, 200, 120));
      Plot7(LinhaMenos2);
      SetPlotColor(7, RGB(0, 200, 120));
    end;

    if MostrarAlvo3 then
    begin
      Plot8(LinhaMais3);
      SetPlotColor(8, RGB(220, 80, 80));
      Plot9(LinhaMenos3);
      SetPlotColor(9, RGB(220, 80, 80));
    end;

    if MostrarMediaCurta then
    begin
      Plot10(MediaBandasCurta);
      SetPlotColor(10, RGB(255, 165, 0));
      SetPlotWidth(10, 2);
    end;

    if MostrarMediaLonga then
    begin
      Plot11(MediaBandasLonga);
      SetPlotColor(11, RGB(180, 80, 255));
      SetPlotWidth(11, 2);
    end;

    Plot12(ScoreComprador);
    SetPlotColor(12, RGB(0, 200, 100));
    Plot13(ScoreVendedor);
    SetPlotColor(13, RGB(220, 60, 60));

    // ========================================================================
    // 9. PAINTBAR — P0 (Abertura) tem prioridade máxima
    // ========================================================================
    if PintarCandles then
    begin
      PintouEvento := false;

      // ---- P0 — ACEITAÇÃO / REJEIÇÃO DA ABERTURA (prioridade máxima) ----
      if not PintouEvento then
        if ConfirmouAceitacaoAberturaCompra or ConfirmouRejeicaoAberturaCompra then
        begin
          PaintBar(RGB(0, 255, 180));          // Verde-água — Abertura confirma compra
          PintouEvento := true;
        end;

      if not PintouEvento then
        if ConfirmouAceitacaoAberturaVenda or ConfirmouRejeicaoAberturaVenda then
        begin
          PaintBar(RGB(255, 40, 120));         // Rosa-choque — Abertura confirma venda
          PintouEvento := true;
        end;

      if not PintouEvento then
        if AceitacaoAberturaCompra or RejeicaoAberturaCompra then
        begin
          PaintBar(RGB(100, 255, 200));        // Verde-água claro
          PintouEvento := true;
        end;

      if not PintouEvento then
        if AceitacaoAberturaVenda or RejeicaoAberturaVenda then
        begin
          PaintBar(RGB(255, 120, 180));        // Rosa claro
          PintouEvento := true;
        end;

      // ---- P1 — CONFIRMAÇÃO DE ARMADILHA ±1% ----
      if not PintouEvento then
        if ConfirmouArmadilhaMais1 then
        begin
          PaintBar(RGB(218, 11, 11));
          PintouEvento := true;
        end;

      if not PintouEvento then
        if ConfirmouArmadilhaMenos1 then
        begin
          PaintBar(RGB(11, 218, 94));
          PintouEvento := true;
        end;

      // ---- P2 — CONFIRMAÇÃO DE ARMADILHA outras bandas ----
      if not PintouEvento then
        if ConfirmouArmadilhaMaisMeio then
        begin
          PaintBar(RGB(246, 85, 112));
          PintouEvento := true;
        end;
      if not PintouEvento then
        if ConfirmouArmadilhaMenosMeio then
        begin
          PaintBar(RGB(132, 94, 237));
          PintouEvento := true;
        end;
      if not PintouEvento then
        if ConfirmouArmadilhaMais2 then
        begin
          PaintBar(RGB(201, 13, 182));
          PintouEvento := true;
        end;
      if not PintouEvento then
        if ConfirmouArmadilhaMenos2 then
        begin
          PaintBar(RGB(13, 82, 201));
          PintouEvento := true;
        end;
      if not PintouEvento then
        if ConfirmouArmadilhaMais3 then
        begin
          PaintBar(RGB(201, 13, 98));
          PintouEvento := true;
        end;
      if not PintouEvento then
        if ConfirmouArmadilhaMenos3 then
        begin
          PaintBar(RGB(13, 54, 201));
          PintouEvento := true;
        end;

      // ---- P3 — CONFIRMAÇÃO DE REJEIÇÃO ±1% ----
      if not PintouEvento then
        if ConfirmouRejeicaoMais1 then
        begin
          PaintBar(RGB(191, 110, 17));
          PintouEvento := true;
        end;
      if not PintouEvento then
        if ConfirmouRejeicaoMenos1 then
        begin
          PaintBar(RGB(17, 153, 158));
          PintouEvento := true;
        end;

      // ---- P4 — ARMADILHA NÃO CONFIRMADA ±1% ----
      if not PintouEvento then
        if ArmadilhaMais1 then
        begin
          PaintBar(RGB(217, 137, 21));
          PintouEvento := true;
        end;
      if not PintouEvento then
        if ArmadilhaMenos1 then
        begin
          PaintBar(RGB(33, 99, 217));
          PintouEvento := true;
        end;

      // ---- P5 — REJEIÇÃO NÃO CONFIRMADA ±1% ----
      if not PintouEvento then
        if RejeitouMais1 then
        begin
          PaintBar(RGB(245, 199, 143));
          PintouEvento := true;
        end;
      if not PintouEvento then
        if RejeitouMenos1 then
        begin
          PaintBar(RGB(143, 190, 245));
          PintouEvento := true;
        end;

      // ---- P6 — ACEITAÇÃO ±1% ----
      if not PintouEvento then
        if AceitouMais1 then
        begin
          PaintBar(RGB(0, 150, 136));
          PintouEvento := true;
        end;
      if not PintouEvento then
        if AceitouMenos1 then
        begin
          PaintBar(RGB(156, 39, 176));
          PintouEvento := true;
        end;

      // ---- P7 — Outros eventos ----
      if not PintouEvento then
        if ArmadilhaMaisMeio or ArmadilhaMais2 or ArmadilhaMais3 then
        begin
          PaintBar(RGB(242, 196, 13));
          PintouEvento := true;
        end;
      if not PintouEvento then
        if ArmadilhaMenosMeio or ArmadilhaMenos2 or ArmadilhaMenos3 then
        begin
          PaintBar(RGB(85, 193, 246));
          PintouEvento := true;
        end;
      if not PintouEvento then
        if RejeitouMaisMeio or RejeitouMais2 or RejeitouMais3 then
        begin
          PaintBar(RGB(250, 235, 180));
          PintouEvento := true;
        end;
      if not PintouEvento then
        if RejeitouMenosMeio or RejeitouMenos2 or RejeitouMenos3 then
        begin
          PaintBar(RGB(190, 225, 250));
          PintouEvento := true;
        end;
    end;
  end;

end;
