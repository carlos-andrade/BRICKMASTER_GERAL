// ============================================================================
// BRICKMASTER V14_versao0_GROK

// NOME NO CLAUDE: BRICKMASTER_V14_GROK
// NOME NO PROFIT: CAR_1CENTO_v14_v0_GROK

// ----------------------------------------------------------------------------
// Autor original : Carlos Andrade
// Recriação     : Grok (xAI) — 12/09/2026
// Plataforma    : Profit / Nelogica — CARREGAR COMO ESTRATÉGIA
// Linguagem     : NTSL (Manual v4.2)
// ----------------------------------------------------------------------------
// OBJETIVO DESTA VERSÃO (V14_versao0):
// Primeira versão limpa e modular.
// Contém APENAS o Módulo Base:
//   1. Cálculo da Abertura do Dia
//   2. Cálculo das 8 bandas percentuais (±0,5% / ±1% / ±2% / ±3%)
//   3. Cálculo das duas médias de variação das bandas (Curta e Longa)
//   4. Plotagem das linhas e das médias
//
// Nada de execução, score, alertas, volume anômalo, abertura zero, recusa etc.
// Esta é a fundação sobre a qual todos os outros módulos serão construídos.
// ============================================================================

input
  // --- Bandas percentuais ---
  PercentualMeio(0.50);          // ±0,50%
  PercentualAlvo1(1.00);         // ±1,00%
  PercentualAlvo2(2.00);         // ±2,00%
  PercentualAlvo3(3.00);         // ±3,00%

  // --- Médias de variação das bandas ---
  PeriodoMediaBandasCurta(9);    // Média curta (padrão 9)
  PeriodoMediaBandasLonga(25);   // Média longa (padrão 25)

  // --- Controles de plotagem ---
  MostrarAbertura(true);         // Linha branca da abertura do dia
  MostrarMeio(true);
  MostrarAlvo1(true);
  MostrarAlvo2(true);
  MostrarAlvo3(true);
  MostrarMediaCurta(true);
  MostrarMediaLonga(true);

var
  // Controle de novo dia
  NovoDia                   : Boolean;
  AberturaDia               : Float;

  // Bandas
  LinhaMaisMeio             : Float;
  LinhaMenosMeio            : Float;
  LinhaMais1                : Float;
  LinhaMenos1               : Float;
  LinhaMais2                : Float;
  LinhaMenos2               : Float;
  LinhaMais3                : Float;
  LinhaMenos3               : Float;

  // Variação percentual atual em relação à abertura
  VariacaoAtual             : Float;

  // Médias de variação
  SomaVariacaoCurta         : Float;
  SomaVariacaoLonga         : Float;
  MediaVariacaoBandasCurta  : Float;
  MediaVariacaoBandasLonga  : Float;
  MediaBandasCurta          : Float;
  MediaBandasLonga          : Float;

  // Auxiliares de média
  i                         : Integer;

begin
  // ========================================================================
  // 1. DETECÇÃO DE NOVO DIA E CAPTURA DA ABERTURA
  // ========================================================================
  NovoDia := (Date <> Date[1]);

  if NovoDia then
    AberturaDia := Open;

  // Só executa o resto se já tivermos uma abertura válida
  if AberturaDia > 0 then
  begin
    // ========================================================================
    // 2. CÁLCULO DAS 8 BANDAS PERCENTUAIS
    // ========================================================================
    LinhaMaisMeio  := AberturaDia * (1 + PercentualMeio  / 100);
    LinhaMenosMeio := AberturaDia * (1 - PercentualMeio  / 100);

    LinhaMais1     := AberturaDia * (1 + PercentualAlvo1 / 100);
    LinhaMenos1    := AberturaDia * (1 - PercentualAlvo1 / 100);

    LinhaMais2     := AberturaDia * (1 + PercentualAlvo2 / 100);
    LinhaMenos2    := AberturaDia * (1 - PercentualAlvo2 / 100);

    LinhaMais3     := AberturaDia * (1 + PercentualAlvo3 / 100);
    LinhaMenos3    := AberturaDia * (1 - PercentualAlvo3 / 100);

    // ========================================================================
    // 3. VARIAÇÃO PERCENTUAL ATUAL (usada para as médias)
    // ========================================================================
    VariacaoAtual := ((Close - AberturaDia) / AberturaDia) * 100;

    // ========================================================================
    // 4. MÉDIAS DE VARIAÇÃO DAS BANDAS (Curta e Longa)
    // ========================================================================
    // Média Curta
    SomaVariacaoCurta := 0;
    for i := 0 to PeriodoMediaBandasCurta - 1 do
      SomaVariacaoCurta := SomaVariacaoCurta + VariacaoAtual[i];

    MediaVariacaoBandasCurta := SomaVariacaoCurta / PeriodoMediaBandasCurta;
    MediaBandasCurta := AberturaDia * (1 + MediaVariacaoBandasCurta / 100);

    // Média Longa
    SomaVariacaoLonga := 0;
    for i := 0 to PeriodoMediaBandasLonga - 1 do
      SomaVariacaoLonga := SomaVariacaoLonga + VariacaoAtual[i];

    MediaVariacaoBandasLonga := SomaVariacaoLonga / PeriodoMediaBandasLonga;
    MediaBandasLonga := AberturaDia * (1 + MediaVariacaoBandasLonga / 100);

    // ========================================================================
    // 5. PLOTAGEM DAS LINHAS E MÉDIAS
    // ========================================================================

    // Linha branca da Abertura do Dia
    if MostrarAbertura then
    begin
      Plot(AberturaDia);
      SetPlotColor(1, RGB(255, 255, 255));  // Branco
      SetPlotWidth(1, 2);
    end;

    // Bandas ±0,50%
    if MostrarMeio then
    begin
      Plot2(LinhaMaisMeio);
      SetPlotColor(2, RGB(180, 180, 50));   // Amarelo suave
      Plot3(LinhaMenosMeio);
      SetPlotColor(3, RGB(180, 180, 50));
    end;

    // Bandas ±1%
    if MostrarAlvo1 then
    begin
      Plot4(LinhaMais1);
      SetPlotColor(4, RGB(0, 180, 255));    // Azul
      Plot5(LinhaMenos1);
      SetPlotColor(5, RGB(0, 180, 255));
    end;

    // Bandas ±2%
    if MostrarAlvo2 then
    begin
      Plot6(LinhaMais2);
      SetPlotColor(6, RGB(0, 200, 120));    // Verde
      Plot7(LinhaMenos2);
      SetPlotColor(7, RGB(0, 200, 120));
    end;

    // Bandas ±3%
    if MostrarAlvo3 then
    begin
      Plot8(LinhaMais3);
      SetPlotColor(8, RGB(220, 80, 80));    // Vermelho
      Plot9(LinhaMenos3);
      SetPlotColor(9, RGB(220, 80, 80));
    end;

    // Média Curta (M9)
    if MostrarMediaCurta then
    begin
      Plot10(MediaBandasCurta);
      SetPlotColor(10, RGB(255, 165, 0));   // Laranja
      SetPlotWidth(10, 2);
    end;

    // Média Longa (M25)
    if MostrarMediaLonga then
    begin
      Plot11(MediaBandasLonga);
      SetPlotColor(11, RGB(180, 80, 255));  // Roxo
      SetPlotWidth(11, 2);
    end;
  end;

end;
