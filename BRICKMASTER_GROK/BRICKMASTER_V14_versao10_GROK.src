// ============================================================================
// BRICKMASTER V14_versao10_GROK

// NOME NO CLAUDE: BRICKMASTER_V14_GROK
// NOME NO PROFIT: CAR_1CENTO_v14_v10_GROK

// ----------------------------------------------------------------------------
// Autor original : Carlos Andrade
// Recriação     : Grok (xAI) — 13/09/2026
// Plataforma    : Profit / Nelogica — CARREGAR COMO ESTRATÉGIA
// Linguagem     : NTSL (Manual v4.2)
// ----------------------------------------------------------------------------
// VERSÃO: V14_versao7
// Módulos: 00–09 + 10 Proxy Fluxo / VWAP / Agressão → NOVO (FINAL)
//
// REGRA OBRIGATÓRIA:
//   1. Coloração de candles (PaintBar) — ativa
//   2. Sistema com fonte (PlotText/Alert legível + offset) — ATIVO NESTA VERSÃO
//
// Hierarquia de alertas:
//   N0  Contexto / Dia Direcional
//   N1  Toques
//   N2  Armadilha / Rejeição não confirmadas
//   N2.9 Abertura
//   N2.95 Recusa
//   N3  Confirmações operacionais
//   N4  Volume Anômalo
//   08  Execução (Sinal → Permissão → Ordem)
// ============================================================================

input
  PercentualMeio(0.50);
  PercentualAlvo1(1.00);
  PercentualAlvo2(2.00);
  PercentualAlvo3(3.00);
  PeriodoMediaBandasCurta(9);
  PeriodoMediaBandasLonga(25);
  MostrarAbertura(true);
  MostrarMeio(true);
  MostrarAlvo1(true);
  MostrarAlvo2(true);
  MostrarAlvo3(true);
  MostrarMediaCurta(true);
  MostrarMediaLonga(true);
  PintarCandles(true);
  MostrarAlertas(true);              // Liga/desliga PlotText + Alert
  MinPavioRejeicao(0.40);
  MinPavioArmadilha(0.55);
  DiferencaMinimaScore(3.0);
  PesoConfirmacaoArmadilha1(2.0);
  PesoConfirmacaoArmadilhaOutros(1.5);
  PesoConfirmacaoRejeicao1(1.5);
  PesoArmadilha1(1.0);
  PesoRejeicao1(0.7);
  PesoAceitacao1(0.8);
  PesoEventosSecundarios(0.5);
  PesoAbertura(3.0);
  PesoRecusa(3.0);
  ReforcoScoreEmAlerta(1.5);
  MinRIRecusa(0.55);
  MinWickRecusa(0.45);
  MinEvidenceRecusa(3);
  JanelaRecusa(5);
  FatorAnomaliaVolume(1.8);
  PeriodoMediaVolume(20);
  PesoForcaCandle(40);
  PesoForcaDia(60);
  EspacoTexto(12);                   // Espaçamento base do PlotText
  TamanhoFonte(8);                   // Tamanho da fonte dos textos

  // --- Execucao ---
  HabilitarExecucao(true);           // Liga/desliga envio de ordens
  QuantidadeContratos(1.0);          // Quantidade por ordem
  MaxOperacoesDia(4);                // Trava diaria de operacoes
  HorarioInicio(900);                // Inicio permitido (HHMM) 09:00
  HorarioFim(1700);                  // Fim permitido (HHMM) 17:00
  ExigirContexto(true);              // So opera a favor do Contexto
  ExigirConfirmacao(true);           // So entra em confirmacoes (nao em toques)

  // --- Trailing + Gestao de Risco ---
  HabilitarTrailing(true);           // Liga gestao de saida
  StopInicialPct(0.30);              // Stop inicial em % do preco de entrada
  AlvoFase1Pct(0.40);                // Lucro % para ativar fase 2 (trailing)
  TrailingPct(0.20);                 // Distancia do trailing na fase 2
  AlvoFinalPct(1.00);                // Take profit final em %
  FecharNoFimDoDia(true);            // Zera posicao no fim da janela
  HorarioFechaPosicao(1755);         // HHMM para fechar posicoes abertas

  // --- Fluxo / VWAP / Agressao ---
  HabilitarFluxo(true);              // Liga modulo de fluxo
  PeriodoVWAP(1);                    // 0=barra 1=diario 2=semanal 3=mensal
  MostrarVWAP(true);                 // Plota VWAP
  ExigirFluxo(false);                // Se true, so executa a favor do fluxo
  PesoFluxoScore(1.0);               // Reforco no Score quando fluxo alinha
  UsarAgressaoNativa(false);         // true = AgressionVolBalance (Pro/Ultra/Scalper)

var
  LinhaMaisMeio, LinhaMenosMeio, LinhaMais1, LinhaMenos1 : Float;
  LinhaMais2, LinhaMenos2, LinhaMais3, LinhaMenos3 : Float;
  VariacaoAtual, SomaVariacaoCurta, SomaVariacaoLonga : Float;
  MediaVariacaoBandasCurta, MediaVariacaoBandasLonga : Float;
  MediaBandasCurta, MediaBandasLonga : Float;
  i, PeriodoEfetivoCurta, PeriodoEfetivoLonga : Integer;
  Corpo, RangeCandle, PavioSuperior, PavioInferior, RI : Float;
  CandleAlta, CandleBaixa : Boolean;
  PctPavioSuperior, PctPavioInferior : Float;

  TocouMaisMeio, TocouMenosMeio, AceitouMaisMeio, AceitouMenosMeio : Boolean;
  RejeitouMaisMeio, RejeitouMenosMeio, ArmadilhaMaisMeio, ArmadilhaMenosMeio : Boolean;
  ConfirmouRejeicaoMaisMeio, ConfirmouRejeicaoMenosMeio : Boolean;
  ConfirmouArmadilhaMaisMeio, ConfirmouArmadilhaMenosMeio : Boolean;
  TocouMais1, TocouMenos1, AceitouMais1, AceitouMenos1 : Boolean;
  RejeitouMais1, RejeitouMenos1, ArmadilhaMais1, ArmadilhaMenos1 : Boolean;
  ConfirmouRejeicaoMais1, ConfirmouRejeicaoMenos1 : Boolean;
  ConfirmouArmadilhaMais1, ConfirmouArmadilhaMenos1 : Boolean;
  TocouMais2, TocouMenos2, AceitouMais2, AceitouMenos2 : Boolean;
  RejeitouMais2, RejeitouMenos2, ArmadilhaMais2, ArmadilhaMenos2 : Boolean;
  ConfirmouRejeicaoMais2, ConfirmouRejeicaoMenos2 : Boolean;
  ConfirmouArmadilhaMais2, ConfirmouArmadilhaMenos2 : Boolean;
  TocouMais3, TocouMenos3, AceitouMais3, AceitouMenos3 : Boolean;
  RejeitouMais3, RejeitouMenos3, ArmadilhaMais3, ArmadilhaMenos3 : Boolean;
  ConfirmouRejeicaoMais3, ConfirmouRejeicaoMenos3 : Boolean;
  ConfirmouArmadilhaMais3, ConfirmouArmadilhaMenos3 : Boolean;

  PintouEvento : Boolean;
  ScoreComprador, ScoreVendedor, DiferencaScore : Float;
  ContextoComprador, ContextoVendedor, ContextoNeutro : Boolean;
  DiaDirecionalCompra, DiaDirecionalVenda : Boolean;

  TocouMaisMeioHoje, TocouMenosMeioHoje : Boolean;
  PrecoAcimaAbertura, PrecoAbaixoAbertura : Boolean;
  CruzouAberturaParaCima, CruzouAberturaParaBaixo : Boolean;
  AceitacaoAberturaCompra, AceitacaoAberturaVenda : Boolean;
  RejeicaoAberturaCompra, RejeicaoAberturaVenda : Boolean;
  ConfirmouAceitacaoAberturaCompra, ConfirmouAceitacaoAberturaVenda : Boolean;
  ConfirmouRejeicaoAberturaCompra, ConfirmouRejeicaoAberturaVenda : Boolean;

  TocouAlgumaBanda, RecusaAlta, RecusaBaixa : Boolean;
  EstadoRecusa, ContadorEvidenciasRecusa : Integer;
  RecusaAtiva, ConfirmouRecusaAlta, ConfirmouRecusaBaixa : Boolean;

  MediaVolumeCandle, VolumeAcumuladoDia, MediaVolumeDia : Float;
  ForcaCandle, ForcaDia, ForcaVolume : Float;
  VolumeAnomalo : Boolean;
  MultiplicadorScore : Float;
  HoraAtual, JanelaAtual : Integer;

  // Alertas
  OffsetTexto : Integer;
  TextoAlerta : String;
  NovoDiaBool : Boolean;
  AberturaDiaF : Float;
  BarrasDoDiaI : Integer;

  // Execucao
  OperacoesDia : Integer;
  DentroHorario : Boolean;
  PodeOperar : Boolean;
  SinalCompra : Boolean;
  SinalVenda : Boolean;
  HoraHHMM : Integer;

  // Trailing / risco
  PrecoEntrada : Float;
  StopAtual : Float;
  MelhorPreco : Float;
  FaseTrailing : Integer;            // 0=sem posicao | 1=stop inicial | 2=trailing ativo
  ResultadoTick : Float;

  // Fluxo / VWAP
  ValorVWAP : Float;
  PrecoAcimaVWAP : Boolean;
  PrecoAbaixoVWAP : Boolean;
  DistanciaVWAPPct : Float;
  AgressaoSaldo : Float;
  FluxoComprador : Boolean;
  FluxoVendedor : Boolean;
  FluxoNeutro : Boolean;
  ProxyAgressao : Float;

begin
  NovoDiaBool := (Date <> Date[1]);

  if NovoDiaBool then
  begin
    AberturaDiaF := Open;
    BarrasDoDiaI := 1;
    SomaVariacaoCurta := 0;
    SomaVariacaoLonga := 0;
    ScoreComprador := 0;
    ScoreVendedor := 0;
    TocouMaisMeioHoje := false;
    TocouMenosMeioHoje := false;
    EstadoRecusa := 0;
    ContadorEvidenciasRecusa := 0;
    VolumeAcumuladoDia := 0;
    OperacoesDia := 0;
    FaseTrailing := 0;
    PrecoEntrada := 0;
    StopAtual := 0;
    MelhorPreco := 0;
  end
  else
    BarrasDoDiaI := BarrasDoDiaI + 1;

  if AberturaDiaF > 0 then
  begin
    // Bandas
    LinhaMaisMeio  := AberturaDiaF * (1 + PercentualMeio / 100);
    LinhaMenosMeio := AberturaDiaF * (1 - PercentualMeio / 100);
    LinhaMais1     := AberturaDiaF * (1 + PercentualAlvo1 / 100);
    LinhaMenos1    := AberturaDiaF * (1 - PercentualAlvo1 / 100);
    LinhaMais2     := AberturaDiaF * (1 + PercentualAlvo2 / 100);
    LinhaMenos2    := AberturaDiaF * (1 - PercentualAlvo2 / 100);
    LinhaMais3     := AberturaDiaF * (1 + PercentualAlvo3 / 100);
    LinhaMenos3    := AberturaDiaF * (1 - PercentualAlvo3 / 100);

    VariacaoAtual := ((Close - AberturaDiaF) / AberturaDiaF) * 100;

    if BarrasDoDiaI <= PeriodoMediaBandasCurta then PeriodoEfetivoCurta := BarrasDoDiaI
    else PeriodoEfetivoCurta := PeriodoMediaBandasCurta;
    SomaVariacaoCurta := 0;
    for i := 0 to PeriodoEfetivoCurta - 1 do
      SomaVariacaoCurta := SomaVariacaoCurta + VariacaoAtual[i];
    if PeriodoEfetivoCurta > 0 then MediaVariacaoBandasCurta := SomaVariacaoCurta / PeriodoEfetivoCurta
    else MediaVariacaoBandasCurta := 0;
    MediaBandasCurta := AberturaDiaF * (1 + MediaVariacaoBandasCurta / 100);

    if BarrasDoDiaI <= PeriodoMediaBandasLonga then PeriodoEfetivoLonga := BarrasDoDiaI
    else PeriodoEfetivoLonga := PeriodoMediaBandasLonga;
    SomaVariacaoLonga := 0;
    for i := 0 to PeriodoEfetivoLonga - 1 do
      SomaVariacaoLonga := SomaVariacaoLonga + VariacaoAtual[i];
    if PeriodoEfetivoLonga > 0 then MediaVariacaoBandasLonga := SomaVariacaoLonga / PeriodoEfetivoLonga
    else MediaVariacaoBandasLonga := 0;
    MediaBandasLonga := AberturaDiaF * (1 + MediaVariacaoBandasLonga / 100);

    if Close >= Open then
    begin
      CandleAlta := true; CandleBaixa := false;
      Corpo := Close - Open; PavioSuperior := High - Close; PavioInferior := Open - Low;
    end
    else
    begin
      CandleAlta := false; CandleBaixa := true;
      Corpo := Open - Close; PavioSuperior := High - Open; PavioInferior := Close - Low;
    end;

    RangeCandle := High - Low;
    if RangeCandle > 0 then
    begin
      PctPavioSuperior := PavioSuperior / RangeCandle;
      PctPavioInferior := PavioInferior / RangeCandle;
      if PavioSuperior > PavioInferior then RI := PavioSuperior / RangeCandle else RI := PavioInferior / RangeCandle;
    end
    else begin PctPavioSuperior := 0; PctPavioInferior := 0; RI := 0; end;

    // Eventos (todas as bandas)
    TocouMaisMeio := (High >= LinhaMaisMeio); TocouMenosMeio := (Low <= LinhaMenosMeio);
    AceitouMaisMeio := (Close > LinhaMaisMeio); AceitouMenosMeio := (Close < LinhaMenosMeio);
    RejeitouMaisMeio := TocouMaisMeio and (Close < LinhaMaisMeio) and (PctPavioSuperior >= MinPavioRejeicao);
    RejeitouMenosMeio := TocouMenosMeio and (Close > LinhaMenosMeio) and (PctPavioInferior >= MinPavioRejeicao);
    ArmadilhaMaisMeio := RejeitouMaisMeio and (PctPavioSuperior >= MinPavioArmadilha);
    ArmadilhaMenosMeio := RejeitouMenosMeio and (PctPavioInferior >= MinPavioArmadilha);
    ConfirmouArmadilhaMaisMeio := ArmadilhaMaisMeio and CandleBaixa;
    ConfirmouArmadilhaMenosMeio := ArmadilhaMenosMeio and CandleAlta;
    ConfirmouRejeicaoMaisMeio := RejeitouMaisMeio and CandleBaixa and (not ArmadilhaMaisMeio);
    ConfirmouRejeicaoMenosMeio := RejeitouMenosMeio and CandleAlta and (not ArmadilhaMenosMeio);

    TocouMais1 := (High >= LinhaMais1); TocouMenos1 := (Low <= LinhaMenos1);
    AceitouMais1 := (Close > LinhaMais1); AceitouMenos1 := (Close < LinhaMenos1);
    RejeitouMais1 := TocouMais1 and (Close < LinhaMais1) and (PctPavioSuperior >= MinPavioRejeicao);
    RejeitouMenos1 := TocouMenos1 and (Close > LinhaMenos1) and (PctPavioInferior >= MinPavioRejeicao);
    ArmadilhaMais1 := RejeitouMais1 and (PctPavioSuperior >= MinPavioArmadilha);
    ArmadilhaMenos1 := RejeitouMenos1 and (PctPavioInferior >= MinPavioArmadilha);
    ConfirmouArmadilhaMais1 := ArmadilhaMais1 and CandleBaixa;
    ConfirmouArmadilhaMenos1 := ArmadilhaMenos1 and CandleAlta;
    ConfirmouRejeicaoMais1 := RejeitouMais1 and CandleBaixa and (not ArmadilhaMais1);
    ConfirmouRejeicaoMenos1 := RejeitouMenos1 and CandleAlta and (not ArmadilhaMenos1);

    TocouMais2 := (High >= LinhaMais2); TocouMenos2 := (Low <= LinhaMenos2);
    AceitouMais2 := (Close > LinhaMais2); AceitouMenos2 := (Close < LinhaMenos2);
    RejeitouMais2 := TocouMais2 and (Close < LinhaMais2) and (PctPavioSuperior >= MinPavioRejeicao);
    RejeitouMenos2 := TocouMenos2 and (Close > LinhaMenos2) and (PctPavioInferior >= MinPavioRejeicao);
    ArmadilhaMais2 := RejeitouMais2 and (PctPavioSuperior >= MinPavioArmadilha);
    ArmadilhaMenos2 := RejeitouMenos2 and (PctPavioInferior >= MinPavioArmadilha);
    ConfirmouArmadilhaMais2 := ArmadilhaMais2 and CandleBaixa;
    ConfirmouArmadilhaMenos2 := ArmadilhaMenos2 and CandleAlta;
    ConfirmouRejeicaoMais2 := RejeitouMais2 and CandleBaixa and (not ArmadilhaMais2);
    ConfirmouRejeicaoMenos2 := RejeitouMenos2 and CandleAlta and (not ArmadilhaMenos2);

    TocouMais3 := (High >= LinhaMais3); TocouMenos3 := (Low <= LinhaMenos3);
    AceitouMais3 := (Close > LinhaMais3); AceitouMenos3 := (Close < LinhaMenos3);
    RejeitouMais3 := TocouMais3 and (Close < LinhaMais3) and (PctPavioSuperior >= MinPavioRejeicao);
    RejeitouMenos3 := TocouMenos3 and (Close > LinhaMenos3) and (PctPavioInferior >= MinPavioRejeicao);
    ArmadilhaMais3 := RejeitouMais3 and (PctPavioSuperior >= MinPavioArmadilha);
    ArmadilhaMenos3 := RejeitouMenos3 and (PctPavioInferior >= MinPavioArmadilha);
    ConfirmouArmadilhaMais3 := ArmadilhaMais3 and CandleBaixa;
    ConfirmouArmadilhaMenos3 := ArmadilhaMenos3 and CandleAlta;
    ConfirmouRejeicaoMais3 := RejeitouMais3 and CandleBaixa and (not ArmadilhaMais3);
    ConfirmouRejeicaoMenos3 := RejeitouMenos3 and CandleAlta and (not ArmadilhaMenos3);

    if TocouMaisMeio then TocouMaisMeioHoje := true;
    if TocouMenosMeio then TocouMenosMeioHoje := true;

    // Abertura
    PrecoAcimaAbertura := (Close > AberturaDiaF);
    PrecoAbaixoAbertura := (Close < AberturaDiaF);
    CruzouAberturaParaCima := (Close > AberturaDiaF) and (Close[1] <= AberturaDiaF);
    CruzouAberturaParaBaixo := (Close < AberturaDiaF) and (Close[1] >= AberturaDiaF);
    AceitacaoAberturaCompra := CruzouAberturaParaCima and TocouMenosMeioHoje;
    AceitacaoAberturaVenda := CruzouAberturaParaBaixo and TocouMaisMeioHoje;
    RejeicaoAberturaCompra := (Low <= AberturaDiaF) and (Close > AberturaDiaF) and TocouMaisMeioHoje and CandleAlta and (PctPavioInferior >= MinPavioRejeicao);
    RejeicaoAberturaVenda := (High >= AberturaDiaF) and (Close < AberturaDiaF) and TocouMenosMeioHoje and CandleBaixa and (PctPavioSuperior >= MinPavioRejeicao);
    ConfirmouAceitacaoAberturaCompra := AceitacaoAberturaCompra[1] and CandleAlta and PrecoAcimaAbertura;
    ConfirmouAceitacaoAberturaVenda := AceitacaoAberturaVenda[1] and CandleBaixa and PrecoAbaixoAbertura;
    ConfirmouRejeicaoAberturaCompra := RejeicaoAberturaCompra[1] and CandleAlta and PrecoAcimaAbertura;
    ConfirmouRejeicaoAberturaVenda := RejeicaoAberturaVenda[1] and CandleBaixa and PrecoAbaixoAbertura;

    // Recusa
    TocouAlgumaBanda := TocouMaisMeio or TocouMenosMeio or TocouMais1 or TocouMenos1 or TocouMais2 or TocouMenos2 or TocouMais3 or TocouMenos3 or (High >= AberturaDiaF) or (Low <= AberturaDiaF);
    RecusaAlta := (RI >= MinRIRecusa) and (PctPavioSuperior >= MinWickRecusa) and (PctPavioSuperior > PctPavioInferior) and CandleBaixa and TocouAlgumaBanda;
    RecusaBaixa := (RI >= MinRIRecusa) and (PctPavioInferior >= MinWickRecusa) and (PctPavioInferior > PctPavioSuperior) and CandleAlta and TocouAlgumaBanda;
    if RecusaAlta or RecusaBaixa then
    begin
      ContadorEvidenciasRecusa := ContadorEvidenciasRecusa + 1;
      if ContadorEvidenciasRecusa >= MinEvidenceRecusa then EstadoRecusa := 7
      else if ContadorEvidenciasRecusa >= 2 then EstadoRecusa := 4
      else EstadoRecusa := 1;
    end
    else
    begin
      if ContadorEvidenciasRecusa > 0 then ContadorEvidenciasRecusa := ContadorEvidenciasRecusa - 1;
      if ContadorEvidenciasRecusa = 0 then EstadoRecusa := 0;
    end;
    RecusaAtiva := (EstadoRecusa >= 4);
    ConfirmouRecusaAlta := RecusaAlta and (EstadoRecusa = 7);
    ConfirmouRecusaBaixa := RecusaBaixa and (EstadoRecusa = 7);

    // Volume
    MediaVolumeCandle := 0;
    for i := 0 to PeriodoMediaVolume - 1 do MediaVolumeCandle := MediaVolumeCandle + Volume[i];
    MediaVolumeCandle := MediaVolumeCandle / PeriodoMediaVolume;
    VolumeAcumuladoDia := VolumeAcumuladoDia + Volume;
    if BarrasDoDiaI > 0 then MediaVolumeDia := VolumeAcumuladoDia / BarrasDoDiaI else MediaVolumeDia := Volume;
    if MediaVolumeCandle > 0 then ForcaCandle := (Volume / MediaVolumeCandle) * 50 else ForcaCandle := 50;
    if ForcaCandle > 100 then ForcaCandle := 100; if ForcaCandle < 0 then ForcaCandle := 0;
    if MediaVolumeDia > 0 then ForcaDia := (Volume / MediaVolumeDia) * 50 else ForcaDia := 50;
    if ForcaDia > 100 then ForcaDia := 100; if ForcaDia < 0 then ForcaDia := 0;
    ForcaVolume := (ForcaCandle * PesoForcaCandle / 100) + (ForcaDia * PesoForcaDia / 100);
    if ForcaVolume > 100 then ForcaVolume := 100; if ForcaVolume < 0 then ForcaVolume := 0;
    VolumeAnomalo := (MediaVolumeCandle > 0) and (Volume >= MediaVolumeCandle * FatorAnomaliaVolume);
    if VolumeAnomalo then MultiplicadorScore := ReforcoScoreEmAlerta else MultiplicadorScore := 1.0;

    // Score
    if ConfirmouArmadilhaMenos1 and (not ConfirmouArmadilhaMenos1[1]) then ScoreComprador := ScoreComprador + PesoConfirmacaoArmadilha1 * MultiplicadorScore;
    if ConfirmouArmadilhaMais1 and (not ConfirmouArmadilhaMais1[1]) then ScoreVendedor := ScoreVendedor + PesoConfirmacaoArmadilha1 * MultiplicadorScore;
    if ConfirmouArmadilhaMenosMeio and (not ConfirmouArmadilhaMenosMeio[1]) then ScoreComprador := ScoreComprador + PesoConfirmacaoArmadilhaOutros * MultiplicadorScore;
    if ConfirmouArmadilhaMenos2 and (not ConfirmouArmadilhaMenos2[1]) then ScoreComprador := ScoreComprador + PesoConfirmacaoArmadilhaOutros * MultiplicadorScore;
    if ConfirmouArmadilhaMenos3 and (not ConfirmouArmadilhaMenos3[1]) then ScoreComprador := ScoreComprador + PesoConfirmacaoArmadilhaOutros * MultiplicadorScore;
    if ConfirmouArmadilhaMaisMeio and (not ConfirmouArmadilhaMaisMeio[1]) then ScoreVendedor := ScoreVendedor + PesoConfirmacaoArmadilhaOutros * MultiplicadorScore;
    if ConfirmouArmadilhaMais2 and (not ConfirmouArmadilhaMais2[1]) then ScoreVendedor := ScoreVendedor + PesoConfirmacaoArmadilhaOutros * MultiplicadorScore;
    if ConfirmouArmadilhaMais3 and (not ConfirmouArmadilhaMais3[1]) then ScoreVendedor := ScoreVendedor + PesoConfirmacaoArmadilhaOutros * MultiplicadorScore;
    if ConfirmouRejeicaoMenos1 and (not ConfirmouRejeicaoMenos1[1]) then ScoreComprador := ScoreComprador + PesoConfirmacaoRejeicao1 * MultiplicadorScore;
    if ConfirmouRejeicaoMais1 and (not ConfirmouRejeicaoMais1[1]) then ScoreVendedor := ScoreVendedor + PesoConfirmacaoRejeicao1 * MultiplicadorScore;
    if ArmadilhaMenos1 and (not ArmadilhaMenos1[1]) and (not ConfirmouArmadilhaMenos1) then ScoreComprador := ScoreComprador + PesoArmadilha1 * MultiplicadorScore;
    if ArmadilhaMais1 and (not ArmadilhaMais1[1]) and (not ConfirmouArmadilhaMais1) then ScoreVendedor := ScoreVendedor + PesoArmadilha1 * MultiplicadorScore;
    if RejeitouMenos1 and (not RejeitouMenos1[1]) and (not ConfirmouRejeicaoMenos1) and (not ArmadilhaMenos1) then ScoreComprador := ScoreComprador + PesoRejeicao1 * MultiplicadorScore;
    if RejeitouMais1 and (not RejeitouMais1[1]) and (not ConfirmouRejeicaoMais1) and (not ArmadilhaMais1) then ScoreVendedor := ScoreVendedor + PesoRejeicao1 * MultiplicadorScore;
    if AceitouMenos1 and (not AceitouMenos1[1]) then ScoreVendedor := ScoreVendedor + PesoAceitacao1 * MultiplicadorScore;
    if AceitouMais1 and (not AceitouMais1[1]) then ScoreComprador := ScoreComprador + PesoAceitacao1 * MultiplicadorScore;
    if ConfirmouAceitacaoAberturaCompra and (not ConfirmouAceitacaoAberturaCompra[1]) then ScoreComprador := ScoreComprador + PesoAbertura * MultiplicadorScore;
    if ConfirmouAceitacaoAberturaVenda and (not ConfirmouAceitacaoAberturaVenda[1]) then ScoreVendedor := ScoreVendedor + PesoAbertura * MultiplicadorScore;
    if ConfirmouRejeicaoAberturaCompra and (not ConfirmouRejeicaoAberturaCompra[1]) then ScoreComprador := ScoreComprador + PesoAbertura * MultiplicadorScore;
    if ConfirmouRejeicaoAberturaVenda and (not ConfirmouRejeicaoAberturaVenda[1]) then ScoreVendedor := ScoreVendedor + PesoAbertura * MultiplicadorScore;
    if ConfirmouRecusaBaixa and (not ConfirmouRecusaBaixa[1]) then ScoreComprador := ScoreComprador + PesoRecusa * MultiplicadorScore;
    if ConfirmouRecusaAlta and (not ConfirmouRecusaAlta[1]) then ScoreVendedor := ScoreVendedor + PesoRecusa * MultiplicadorScore;

    DiferencaScore := ScoreComprador - ScoreVendedor;
    ContextoComprador := (DiferencaScore >= DiferencaMinimaScore);
    ContextoVendedor := (DiferencaScore <= -DiferencaMinimaScore);
    ContextoNeutro := (not ContextoComprador) and (not ContextoVendedor);
    DiaDirecionalCompra := ContextoComprador and (DiferencaScore >= (DiferencaMinimaScore * 1.5));
    DiaDirecionalVenda := ContextoVendedor and (DiferencaScore <= -(DiferencaMinimaScore * 1.5));

    // Plots base
    if MostrarAbertura then begin Plot(AberturaDiaF); SetPlotColor(1, RGB(255,255,255)); SetPlotWidth(1,2); end;
    if MostrarMeio then begin Plot2(LinhaMaisMeio); SetPlotColor(2, RGB(180,180,50)); Plot3(LinhaMenosMeio); SetPlotColor(3, RGB(180,180,50)); end;
    if MostrarAlvo1 then begin Plot4(LinhaMais1); SetPlotColor(4, RGB(0,180,255)); Plot5(LinhaMenos1); SetPlotColor(5, RGB(0,180,255)); end;
    if MostrarAlvo2 then begin Plot6(LinhaMais2); SetPlotColor(6, RGB(0,200,120)); Plot7(LinhaMenos2); SetPlotColor(7, RGB(0,200,120)); end;
    if MostrarAlvo3 then begin Plot8(LinhaMais3); SetPlotColor(8, RGB(220,80,80)); Plot9(LinhaMenos3); SetPlotColor(9, RGB(220,80,80)); end;
    if MostrarMediaCurta then begin Plot10(MediaBandasCurta); SetPlotColor(10, RGB(255,165,0)); SetPlotWidth(10,2); end;
    if MostrarMediaLonga then begin Plot11(MediaBandasLonga); SetPlotColor(11, RGB(180,80,255)); SetPlotWidth(11,2); end;
    Plot12(ScoreComprador); SetPlotColor(12, RGB(0,200,100));
    Plot13(ScoreVendedor); SetPlotColor(13, RGB(220,60,60));
    Plot14(EstadoRecusa); SetPlotColor(14, RGB(255,200,0));
    Plot15(ForcaVolume); SetPlotColor(15, RGB(0,180,255));
    if VolumeAnomalo then begin Plot16(100); SetPlotColor(16, RGB(255,50,50)); end
    else begin Plot16(0); SetPlotColor(16, RGB(40,40,40)); end;

    // ========================================================================
    // MÓDULO 07 — SISTEMA DE ALERTAS + FONTE (obrigatório)
    // ========================================================================
    // NTSL oficial:
    //   PlotText(Content: String; Color: Integer; Position: Integer; FontSize: Integer)
    //   Position: 0=abaixo | 1=centro | 2=acima | 3=preco
    //   Alert(Color: Integer)  — apenas cor, sem texto

    if MostrarAlertas then
    begin
      // N0 — Contexto / Dia Direcional
      if DiaDirecionalCompra and (not DiaDirecionalCompra[1]) then
      begin
        PlotText("[C] DIA DIRECIONAL COMPRA", clLime, 2, TamanhoFonte);
        Alert(clLime);
      end;
      if DiaDirecionalVenda and (not DiaDirecionalVenda[1]) then
      begin
        PlotText("[V] DIA DIRECIONAL VENDA", clRed, 0, TamanhoFonte);
        Alert(clRed);
      end;
      if ContextoComprador and (not ContextoComprador[1]) and (not DiaDirecionalCompra) then
        PlotText("[C] CONTEXTO COMPRADOR", clGreen, 2, TamanhoFonte);
      if ContextoVendedor and (not ContextoVendedor[1]) and (not DiaDirecionalVenda) then
        PlotText("[V] CONTEXTO VENDEDOR", clMaroon, 0, TamanhoFonte);

      // N2.9 — Abertura
      if ConfirmouAceitacaoAberturaCompra and (not ConfirmouAceitacaoAberturaCompra[1]) then
      begin
        PlotText("[C] ACEITACAO ABERTURA CONF", clAqua, 2, TamanhoFonte);
        Alert(clAqua);
      end;
      if ConfirmouAceitacaoAberturaVenda and (not ConfirmouAceitacaoAberturaVenda[1]) then
      begin
        PlotText("[V] ACEITACAO ABERTURA CONF", clFuchsia, 0, TamanhoFonte);
        Alert(clFuchsia);
      end;
      if ConfirmouRejeicaoAberturaCompra and (not ConfirmouRejeicaoAberturaCompra[1]) then
      begin
        PlotText("[C] REJEICAO ABERTURA CONF", clAqua, 2, TamanhoFonte);
        Alert(clAqua);
      end;
      if ConfirmouRejeicaoAberturaVenda and (not ConfirmouRejeicaoAberturaVenda[1]) then
      begin
        PlotText("[V] REJEICAO ABERTURA CONF", clFuchsia, 0, TamanhoFonte);
        Alert(clFuchsia);
      end;

      // N2.95 — Recusa
      if ConfirmouRecusaBaixa and (not ConfirmouRecusaBaixa[1]) then
      begin
        PlotText("[C] RECUSA BAIXA CONF", clTeal, 2, TamanhoFonte);
        Alert(clTeal);
      end;
      if ConfirmouRecusaAlta and (not ConfirmouRecusaAlta[1]) then
      begin
        PlotText("[V] RECUSA ALTA CONF", clPurple, 0, TamanhoFonte);
        Alert(clPurple);
      end;

      // N3 — Confirmacoes +/-1%
      if ConfirmouArmadilhaMenos1 and (not ConfirmouArmadilhaMenos1[1]) then
      begin
        PlotText("[C] ARMADILHA -1% CONF", clLime, 2, TamanhoFonte);
        Alert(clLime);
      end;
      if ConfirmouArmadilhaMais1 and (not ConfirmouArmadilhaMais1[1]) then
      begin
        PlotText("[V] ARMADILHA +1% CONF", clRed, 0, TamanhoFonte);
        Alert(clRed);
      end;
      if ConfirmouRejeicaoMenos1 and (not ConfirmouRejeicaoMenos1[1]) then
      begin
        PlotText("[C] REJEICAO -1% CONF", clGreen, 2, TamanhoFonte);
        Alert(clGreen);
      end;
      if ConfirmouRejeicaoMais1 and (not ConfirmouRejeicaoMais1[1]) then
      begin
        PlotText("[V] REJEICAO +1% CONF", clMaroon, 0, TamanhoFonte);
        Alert(clMaroon);
      end;

      // N2 — Armadilhas nao confirmadas +/-1%
      if ArmadilhaMenos1 and (not ArmadilhaMenos1[1]) and (not ConfirmouArmadilhaMenos1) then
        PlotText("[C] ARMADILHA -1%", clOlive, 2, TamanhoFonte);
      if ArmadilhaMais1 and (not ArmadilhaMais1[1]) and (not ConfirmouArmadilhaMais1) then
        PlotText("[V] ARMADILHA +1%", clNavy, 0, TamanhoFonte);

      // N4 — Volume Anomalo
      if VolumeAnomalo and (not VolumeAnomalo[1]) then
      begin
        PlotText("[!] VOLUME ANOMALO", clYellow, 2, TamanhoFonte);
        Alert(clYellow);
      end;

      // N4.5 — Fluxo
      if HabilitarFluxo then
      begin
        if FluxoComprador and (not FluxoComprador[1]) then
          PlotText("[C] FLUXO COMPRADOR", clLime, 2, TamanhoFonte);
        if FluxoVendedor and (not FluxoVendedor[1]) then
          PlotText("[V] FLUXO VENDEDOR", clRed, 0, TamanhoFonte);
        if PrecoAcimaVWAP and (not PrecoAcimaVWAP[1]) then
          PlotText("[C] PRECO > VWAP", clGreen, 2, TamanhoFonte);
        if PrecoAbaixoVWAP and (not PrecoAbaixoVWAP[1]) then
          PlotText("[V] PRECO < VWAP", clMaroon, 0, TamanhoFonte);
      end;
    end;

    // ========================================================================
    // MODULO 10 — PROXY DE FLUXO / VWAP / AGRESSAO
    // ========================================================================
    // VWAP diario (ou periodo configuravel)
    // Fluxo: agressao nativa (opcional) ou proxy por posicao do fechamento + volume
    // Pode reforcar Score e filtrar execucao

    if HabilitarFluxo then
    begin
      ValorVWAP := VWAP(PeriodoVWAP);
      PrecoAcimaVWAP := (Close > ValorVWAP) and (ValorVWAP > 0);
      PrecoAbaixoVWAP := (Close < ValorVWAP) and (ValorVWAP > 0);

      if ValorVWAP > 0 then
        DistanciaVWAPPct := ((Close - ValorVWAP) / ValorVWAP) * 100
      else
        DistanciaVWAPPct := 0;

      // Proxy de agressao (funciona em qualquer versao):
      // fechamento no tercil superior/inferior do range + volume acima da media
      if RangeCandle > 0 then
        ProxyAgressao := ((Close - Low) / RangeCandle) * 100
      else
        ProxyAgressao := 50;

      if UsarAgressaoNativa then
        AgressaoSaldo := AgressionVolBalance
      else
        AgressaoSaldo := 0;

      // Classificacao de fluxo
      FluxoComprador := false;
      FluxoVendedor := false;
      FluxoNeutro := true;

      if UsarAgressaoNativa then
      begin
        if AgressaoSaldo > 0 then
        begin
          FluxoComprador := true;
          FluxoNeutro := false;
        end
        else if AgressaoSaldo < 0 then
        begin
          FluxoVendedor := true;
          FluxoNeutro := false;
        end;
      end
      else
      begin
        // Proxy: fechamento forte + volume anomalo ou forca elevada
        if (ProxyAgressao >= 65) and (VolumeAnomalo or (ForcaVolume >= 60)) then
        begin
          FluxoComprador := true;
          FluxoNeutro := false;
        end
        else if (ProxyAgressao <= 35) and (VolumeAnomalo or (ForcaVolume >= 60)) then
        begin
          FluxoVendedor := true;
          FluxoNeutro := false;
        end
        // Fallback so pelo lado do VWAP + posicao do candle
        else if PrecoAcimaVWAP and (ProxyAgressao >= 60) then
        begin
          FluxoComprador := true;
          FluxoNeutro := false;
        end
        else if PrecoAbaixoVWAP and (ProxyAgressao <= 40) then
        begin
          FluxoVendedor := true;
          FluxoNeutro := false;
        end;
      end;

      // Reforco de Score quando fluxo alinha com eventos recentes de contexto
      if FluxoComprador and ContextoComprador then
        ScoreComprador := ScoreComprador + PesoFluxoScore * 0.1;
      if FluxoVendedor and ContextoVendedor then
        ScoreVendedor := ScoreVendedor + PesoFluxoScore * 0.1;

      // Plot VWAP
      if MostrarVWAP and (ValorVWAP > 0) then
      begin
        Plot18(ValorVWAP);
        SetPlotColor(18, RGB(255, 215, 0));
        SetPlotWidth(18, 2);
      end;

      // Plot proxy de agressao (0-100)
      Plot19(ProxyAgressao);
      SetPlotColor(19, RGB(100, 180, 255));
    end
    else
    begin
      FluxoComprador := false;
      FluxoVendedor := false;
      FluxoNeutro := true;
      ValorVWAP := 0;
    end;

    // ========================================================================
    // MÓDULO 08 — EXECUCAO (Sinal → Permissao → Ordem)
    // ========================================================================
    // Camada operacional. Nao altera deteccao/score/cores.
    // Travas: horario, max operacoes/dia, contexto, confirmacao, sem posicao aberta.

    // Hora no formato HHMM (Time na NTSL costuma ser HHMMSS)
    HoraHHMM := Time / 100;

    DentroHorario := (HoraHHMM >= HorarioInicio) and (HoraHHMM <= HorarioFim);

    // Sinais de entrada (somente confirmacoes de alta prioridade)
    SinalCompra := false;
    SinalVenda := false;

    if ExigirConfirmacao then
    begin
      // Confirmacoes compradoras
      if ConfirmouArmadilhaMenos1 and (not ConfirmouArmadilhaMenos1[1]) then
        SinalCompra := true;
      if ConfirmouRejeicaoMenos1 and (not ConfirmouRejeicaoMenos1[1]) then
        SinalCompra := true;
      if ConfirmouAceitacaoAberturaCompra and (not ConfirmouAceitacaoAberturaCompra[1]) then
        SinalCompra := true;
      if ConfirmouRejeicaoAberturaCompra and (not ConfirmouRejeicaoAberturaCompra[1]) then
        SinalCompra := true;
      if ConfirmouRecusaBaixa and (not ConfirmouRecusaBaixa[1]) then
        SinalCompra := true;

      // Confirmacoes vendedoras
      if ConfirmouArmadilhaMais1 and (not ConfirmouArmadilhaMais1[1]) then
        SinalVenda := true;
      if ConfirmouRejeicaoMais1 and (not ConfirmouRejeicaoMais1[1]) then
        SinalVenda := true;
      if ConfirmouAceitacaoAberturaVenda and (not ConfirmouAceitacaoAberturaVenda[1]) then
        SinalVenda := true;
      if ConfirmouRejeicaoAberturaVenda and (not ConfirmouRejeicaoAberturaVenda[1]) then
        SinalVenda := true;
      if ConfirmouRecusaAlta and (not ConfirmouRecusaAlta[1]) then
        SinalVenda := true;
    end;

    // Filtro de contexto (opcional)
    if ExigirContexto then
    begin
      if SinalCompra and (not ContextoComprador) and (not DiaDirecionalCompra) then
        SinalCompra := false;
      if SinalVenda and (not ContextoVendedor) and (not DiaDirecionalVenda) then
        SinalVenda := false;
    end;

    // Filtro de fluxo (opcional — Modulo 10)
    if ExigirFluxo and HabilitarFluxo then
    begin
      if SinalCompra and (not FluxoComprador) then
        SinalCompra := false;
      if SinalVenda and (not FluxoVendedor) then
        SinalVenda := false;
    end;

    // Permissao final
    PodeOperar := HabilitarExecucao and DentroHorario and (OperacoesDia < MaxOperacoesDia) and (not HasPosition);

    // Execucao
    if PodeOperar then
    begin
      if SinalCompra then
      begin
        BuyAtMarket(QuantidadeContratos);
        OperacoesDia := OperacoesDia + 1;
        PrecoEntrada := Close;
        MelhorPreco := Close;
        StopAtual := Close * (1 - StopInicialPct / 100);
        FaseTrailing := 1;
        if MostrarAlertas then
        begin
          PlotText("[C] EXEC COMPRA", clLime, 2, TamanhoFonte);
          Alert(clLime);
        end;
      end
      else if SinalVenda then
      begin
        SellShortAtMarket(QuantidadeContratos);
        OperacoesDia := OperacoesDia + 1;
        PrecoEntrada := Close;
        MelhorPreco := Close;
        StopAtual := Close * (1 + StopInicialPct / 100);
        FaseTrailing := 1;
        if MostrarAlertas then
        begin
          PlotText("[V] EXEC VENDA", clRed, 0, TamanhoFonte);
          Alert(clRed);
        end;
      end;
    end;

    // ========================================================================
    // MODULO 09 — TRAILING + GESTAO DE RISCO (2 fases)
    // ========================================================================
    // Fase 1: stop inicial fixo a partir da entrada
    // Fase 2: apos AlvoFase1Pct de lucro, trailing segue o melhor preco
    // Saida: stop, alvo final ou fim do dia

    if HabilitarTrailing then
    begin
      // --- Posicao COMPRADA ---
      if IsBought then
      begin
        if FaseTrailing = 0 then
        begin
          // Recuperacao se posicao veio de fora
          PrecoEntrada := BuyPrice;
          if PrecoEntrada <= 0 then PrecoEntrada := Close;
          MelhorPreco := High;
          StopAtual := PrecoEntrada * (1 - StopInicialPct / 100);
          FaseTrailing := 1;
        end;

        if High > MelhorPreco then
          MelhorPreco := High;

        // Ativa fase 2 quando lucro atinge AlvoFase1Pct
        if (FaseTrailing = 1) and (MelhorPreco >= PrecoEntrada * (1 + AlvoFase1Pct / 100)) then
        begin
          FaseTrailing := 2;
          StopAtual := MelhorPreco * (1 - TrailingPct / 100);
          if MostrarAlertas then
            PlotText("[C] TRAIL FASE 2", clAqua, 2, TamanhoFonte);
        end;

        // Atualiza trailing na fase 2
        if FaseTrailing = 2 then
        begin
          ResultadoTick := MelhorPreco * (1 - TrailingPct / 100);
          if ResultadoTick > StopAtual then
            StopAtual := ResultadoTick;
        end;

        // Saida por stop
        if Low <= StopAtual then
        begin
          SellToCoverAtMarket(QuantidadeContratos);
          if MostrarAlertas then
          begin
            PlotText("[C] SAIDA STOP", clYellow, 0, TamanhoFonte);
            Alert(clYellow);
          end;
          FaseTrailing := 0;
          PrecoEntrada := 0;
          StopAtual := 0;
          MelhorPreco := 0;
        end
        // Saida por alvo final
        else if High >= PrecoEntrada * (1 + AlvoFinalPct / 100) then
        begin
          SellToCoverAtMarket(QuantidadeContratos);
          if MostrarAlertas then
          begin
            PlotText("[C] SAIDA ALVO", clLime, 2, TamanhoFonte);
            Alert(clLime);
          end;
          FaseTrailing := 0;
          PrecoEntrada := 0;
          StopAtual := 0;
          MelhorPreco := 0;
        end;
      end

      // --- Posicao VENDIDA ---
      else if IsSold then
      begin
        if FaseTrailing = 0 then
        begin
          PrecoEntrada := SellPrice;
          if PrecoEntrada <= 0 then PrecoEntrada := Close;
          MelhorPreco := Low;
          StopAtual := PrecoEntrada * (1 + StopInicialPct / 100);
          FaseTrailing := 1;
        end;

        if Low < MelhorPreco then
          MelhorPreco := Low;

        if (FaseTrailing = 1) and (MelhorPreco <= PrecoEntrada * (1 - AlvoFase1Pct / 100)) then
        begin
          FaseTrailing := 2;
          StopAtual := MelhorPreco * (1 + TrailingPct / 100);
          if MostrarAlertas then
            PlotText("[V] TRAIL FASE 2", clFuchsia, 0, TamanhoFonte);
        end;

        if FaseTrailing = 2 then
        begin
          ResultadoTick := MelhorPreco * (1 + TrailingPct / 100);
          if (StopAtual = 0) or (ResultadoTick < StopAtual) then
            StopAtual := ResultadoTick;
        end;

        if High >= StopAtual then
        begin
          BuyToCoverAtMarket(QuantidadeContratos);
          if MostrarAlertas then
          begin
            PlotText("[V] SAIDA STOP", clYellow, 2, TamanhoFonte);
            Alert(clYellow);
          end;
          FaseTrailing := 0;
          PrecoEntrada := 0;
          StopAtual := 0;
          MelhorPreco := 0;
        end
        else if Low <= PrecoEntrada * (1 - AlvoFinalPct / 100) then
        begin
          BuyToCoverAtMarket(QuantidadeContratos);
          if MostrarAlertas then
          begin
            PlotText("[V] SAIDA ALVO", clRed, 0, TamanhoFonte);
            Alert(clRed);
          end;
          FaseTrailing := 0;
          PrecoEntrada := 0;
          StopAtual := 0;
          MelhorPreco := 0;
        end;
      end
      else
      begin
        // Sem posicao: zera estado
        FaseTrailing := 0;
        PrecoEntrada := 0;
        StopAtual := 0;
        MelhorPreco := 0;
      end;

      // Fechamento forçado no fim do dia
      if FecharNoFimDoDia and HasPosition and (HoraHHMM >= HorarioFechaPosicao) then
      begin
        ClosePosition;
        if MostrarAlertas then
        begin
          PlotText("[!] FECHA FIM DIA", clYellow, 1, TamanhoFonte);
          Alert(clYellow);
        end;
        FaseTrailing := 0;
        PrecoEntrada := 0;
        StopAtual := 0;
        MelhorPreco := 0;
      end;
    end;

    // Plot do stop atual para monitoramento
    if (FaseTrailing > 0) and (StopAtual > 0) then
    begin
      Plot17(StopAtual);
      SetPlotColor(17, RGB(255, 80, 80));
      SetPlotWidth(17, 2);
    end;

    // PaintBar (mesma hierarquia)
    if PintarCandles then
    begin
      PintouEvento := false;
      if not PintouEvento then if ConfirmouAceitacaoAberturaCompra or ConfirmouRejeicaoAberturaCompra then begin PaintBar(RGB(0,255,180)); PintouEvento := true; end;
      if not PintouEvento then if ConfirmouAceitacaoAberturaVenda or ConfirmouRejeicaoAberturaVenda then begin PaintBar(RGB(255,40,120)); PintouEvento := true; end;
      if not PintouEvento then if AceitacaoAberturaCompra or RejeicaoAberturaCompra then begin PaintBar(RGB(100,255,200)); PintouEvento := true; end;
      if not PintouEvento then if AceitacaoAberturaVenda or RejeicaoAberturaVenda then begin PaintBar(RGB(255,120,180)); PintouEvento := true; end;
      if not PintouEvento then if ConfirmouRecusaBaixa then begin PaintBar(RGB(0,220,160)); PintouEvento := true; end;
      if not PintouEvento then if ConfirmouRecusaAlta then begin PaintBar(RGB(220,30,90)); PintouEvento := true; end;
      if not PintouEvento then if RecusaBaixa and RecusaAtiva then begin PaintBar(RGB(80,200,160)); PintouEvento := true; end;
      if not PintouEvento then if RecusaAlta and RecusaAtiva then begin PaintBar(RGB(200,80,120)); PintouEvento := true; end;
      if not PintouEvento then if ConfirmouArmadilhaMais1 then begin PaintBar(RGB(218,11,11)); PintouEvento := true; end;
      if not PintouEvento then if ConfirmouArmadilhaMenos1 then begin PaintBar(RGB(11,218,94)); PintouEvento := true; end;
      if not PintouEvento then if ConfirmouArmadilhaMaisMeio then begin PaintBar(RGB(246,85,112)); PintouEvento := true; end;
      if not PintouEvento then if ConfirmouArmadilhaMenosMeio then begin PaintBar(RGB(132,94,237)); PintouEvento := true; end;
      if not PintouEvento then if ConfirmouArmadilhaMais2 then begin PaintBar(RGB(201,13,182)); PintouEvento := true; end;
      if not PintouEvento then if ConfirmouArmadilhaMenos2 then begin PaintBar(RGB(13,82,201)); PintouEvento := true; end;
      if not PintouEvento then if ConfirmouArmadilhaMais3 then begin PaintBar(RGB(201,13,98)); PintouEvento := true; end;
      if not PintouEvento then if ConfirmouArmadilhaMenos3 then begin PaintBar(RGB(13,54,201)); PintouEvento := true; end;
      if not PintouEvento then if ConfirmouRejeicaoMais1 then begin PaintBar(RGB(191,110,17)); PintouEvento := true; end;
      if not PintouEvento then if ConfirmouRejeicaoMenos1 then begin PaintBar(RGB(17,153,158)); PintouEvento := true; end;
      if not PintouEvento then if ArmadilhaMais1 then begin PaintBar(RGB(217,137,21)); PintouEvento := true; end;
      if not PintouEvento then if ArmadilhaMenos1 then begin PaintBar(RGB(33,99,217)); PintouEvento := true; end;
      if not PintouEvento then if RejeitouMais1 then begin PaintBar(RGB(245,199,143)); PintouEvento := true; end;
      if not PintouEvento then if RejeitouMenos1 then begin PaintBar(RGB(143,190,245)); PintouEvento := true; end;
      if not PintouEvento then if AceitouMais1 then begin PaintBar(RGB(0,150,136)); PintouEvento := true; end;
      if not PintouEvento then if AceitouMenos1 then begin PaintBar(RGB(156,39,176)); PintouEvento := true; end;
      if not PintouEvento then if ArmadilhaMaisMeio or ArmadilhaMais2 or ArmadilhaMais3 then begin PaintBar(RGB(242,196,13)); PintouEvento := true; end;
      if not PintouEvento then if ArmadilhaMenosMeio or ArmadilhaMenos2 or ArmadilhaMenos3 then begin PaintBar(RGB(85,193,246)); PintouEvento := true; end;
      if not PintouEvento then if RejeitouMaisMeio or RejeitouMais2 or RejeitouMais3 then begin PaintBar(RGB(250,235,180)); PintouEvento := true; end;
      if not PintouEvento then if RejeitouMenosMeio or RejeitouMenos2 or RejeitouMenos3 then begin PaintBar(RGB(190,225,250)); PintouEvento := true; end;
    end;
  end;

end;
