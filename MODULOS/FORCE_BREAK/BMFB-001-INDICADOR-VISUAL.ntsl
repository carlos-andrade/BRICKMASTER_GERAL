// BMFB-001 — Indicador visual de rompimentos
// Projeto: BRICKMASTER RAIZ / BM_FORCE_BREAK
// Estado: EXPERIMENTAL — não aprovado para produção
// Versão: 0.1.0 | Data: 2026-10-17
// Norma: GOV-CAB-NORMA-001 v1.0.3
// Repositório: https://github.com/carlos-andrade/BRICKMASTER_GERAL
// Especificação: MODULOS/FORCE_BREAK/BMFB-001-FECHAMENTOS-MINIMAS-MAXIMAS.md
// Escopo: marcação visual de Close[i] < Low[i-N] e Close[i] > High[i-N], N=1..3.
// Segurança: indicador sem funções de ordens; não acoplar ao BRICKMASTER operacional.
// Validação: código ainda não compilado nem executado no Profit nesta sessão.
// Histórico: primeira implementação experimental.

begin
  if CurrentBar >= 1 then
  begin
    if Close < Low[1] then
      PlotText("B1", clRed, 0, 8);

    if Close > High[1] then
      PlotText("A1", clLime, 2, 8);
  end;

  if CurrentBar >= 2 then
  begin
    if Close < Low[2] then
      PlotText("B2", clMaroon, 0, 8);

    if Close > High[2] then
      PlotText("A2", clGreen, 2, 8);
  end;

  if CurrentBar >= 3 then
  begin
    if Close < Low[3] then
      PlotText("B3", clFuchsia, 0, 8);

    if Close > High[3] then
      PlotText("A3", clAqua, 2, 8);
  end;
end;
