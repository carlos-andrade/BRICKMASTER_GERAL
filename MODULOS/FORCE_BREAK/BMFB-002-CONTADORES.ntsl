// BMFB-002 — Contadores cumulativos de rompimentos
// Projeto: BRICKMASTER RAIZ / BM_FORCE_BREAK
// Estado: EXPERIMENTAL — não aprovado para produção
// Versão: 0.1.0 | Data: 2026-10-17
// Norma: GOV-CAB-NORMA-001 v1.0.3
// Repositório: https://github.com/carlos-andrade/BRICKMASTER_GERAL
// Especificação: MODULOS/FORCE_BREAK/BMFB-001-FECHAMENTOS-MINIMAS-MAXIMAS.md
// Escopo: seis contadores cumulativos para Close[i] < Low[i-N] e Close[i] > High[i-N], N=1..3.
// Segurança: indicador sem funções de ordens; contagens referem-se ao histórico carregado no gráfico.
// Validação: código ainda não compilado nem executado no Profit nesta sessão.
// Histórico: primeira implementação experimental.

var
  abaixo1 : Integer;
  abaixo2 : Integer;
  abaixo3 : Integer;
  acima1 : Integer;
  acima2 : Integer;
  acima3 : Integer;

begin
  if CurrentBar() = 0 then
  begin
    abaixo1 := 0;
    abaixo2 := 0;
    abaixo3 := 0;
    acima1 := 0;
    acima2 := 0;
    acima3 := 0;
  end
  else
  begin
    abaixo1 := abaixo1[1];
    abaixo2 := abaixo2[1];
    abaixo3 := abaixo3[1];
    acima1 := acima1[1];
    acima2 := acima2[1];
    acima3 := acima3[1];

    if CurrentBar() >= 1 then
    begin
      if Close < Low[1] then abaixo1 := abaixo1 + 1;
      if Close > High[1] then acima1 := acima1 + 1;
    end;

    if CurrentBar() >= 2 then
    begin
      if Close < Low[2] then abaixo2 := abaixo2 + 1;
      if Close > High[2] then acima2 := acima2 + 1;
    end;

    if CurrentBar() >= 3 then
    begin
      if Close < Low[3] then abaixo3 := abaixo3 + 1;
      if Close > High[3] then acima3 := acima3 + 1;
    end;
  end;

  PlotN(0, abaixo1);
  PlotN(1, abaixo2);
  PlotN(2, abaixo3);
  PlotN(3, acima1);
  PlotN(4, acima2);
  PlotN(5, acima3);
end;
