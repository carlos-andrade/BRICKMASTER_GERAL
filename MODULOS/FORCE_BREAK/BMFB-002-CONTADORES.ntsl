// BMFB-002 — Contadores cumulativos de rompimentos (reinício diário)
// Projeto: BRICKMASTER RAIZ / BM_FORCE_BREAK
// Estado: EXPERIMENTAL — não aprovado para produção
// Versão: 0.2.1 | Data: 2026-10-17
// Norma: GOV-CAB-NORMA-001 v1.0.3
// Repositório: https://github.com/carlos-andrade/BRICKMASTER_GERAL
// Especificação: MODULOS/FORCE_BREAK/BMFB-001-FECHAMENTOS-MINIMAS-MAXIMAS.md
// Regra diária: zerar contadores quando Date <> Date[1]; comparar apenas barras da mesma data.
// Segurança: indicador sem funções de ordens; contagens limitadas ao dia da barra.
// Validação: versão anterior compilada conforme relato do utilizador; esta alteração diária aguarda nova compilação.
// Histórico: v0.2.1 corrige os índices PlotN para a faixa válida 1–99; v0.2.0 implementou reinício diário.

var
  abaixo1 : Integer;
  abaixo2 : Integer;
  abaixo3 : Integer;
  acima1 : Integer;
  acima2 : Integer;
  acima3 : Integer;

begin
  if CurrentBar() = 0 then
  begin
    abaixo1 := 0;
    abaixo2 := 0;
    abaixo3 := 0;
    acima1 := 0;
    acima2 := 0;
    acima3 := 0;
  end
  else
  begin
    if Date <> Date[1] then
    begin
      abaixo1 := 0;
      abaixo2 := 0;
      abaixo3 := 0;
      acima1 := 0;
      acima2 := 0;
      acima3 := 0;
    end
    else
    begin
      abaixo1 := abaixo1[1];
      abaixo2 := abaixo2[1];
      abaixo3 := abaixo3[1];
      acima1 := acima1[1];
      acima2 := acima2[1];
      acima3 := acima3[1];
    end;

    if (CurrentBar() >= 1) and (Date = Date[1]) then
    begin
      if Close < Low[1] then abaixo1 := abaixo1 + 1;
      if Close > High[1] then acima1 := acima1 + 1;
    end;

    if (CurrentBar() >= 2) and (Date = Date[2]) then
    begin
      if Close < Low[2] then abaixo2 := abaixo2 + 1;
      if Close > High[2] then acima2 := acima2 + 1;
    end;

    if (CurrentBar() >= 3) and (Date = Date[3]) then
    begin
      if Close < Low[3] then abaixo3 := abaixo3 + 1;
      if Close > High[3] then acima3 := acima3 + 1;
    end;
  end;

  PlotN(1, abaixo1);
  PlotN(2, abaixo2);
  PlotN(3, abaixo3);
  PlotN(4, acima1);
  PlotN(5, acima2);
  PlotN(6, acima3);
end;
