{
==================================================================================
  BRICKMASTER — REJECTION ENGINE V1.0 (DIAGNÓSTICO)
  Plataforma: Profit Ultra / Nelogica — Linguagem: NTSL
  Gráfico-alvo: WINFUT — 60.000 TICKS (candle = 60.000 ticks, não é tempo)

  ESTE MÓDULO É SOMENTE DIAGNÓSTICO.
  NÃO envia ordens. NÃO usa BuyAtMarket/SellShortAtMarket/BuyStop/SellShortStop/
  ReversePosition. Apenas calcula, classifica e plota.

  Fora do escopo da V1.0 (deliberadamente): VIX, RSI, MACD, FVG, VWAP, TWAP,
  calendário econômico, ATR como filtro, médias adicionais.

  IMPORTANTE — LEIA ANTES DE COMPILAR:
  Este código não foi auditado contra o .src real do BRICKMASTER V12 (não
  disponibilizado nesta conversa). Usei apenas funções já confirmadas em
  mensagens anteriores (Max, Min, Abs, MediaExp, AgressionVolBalance, Alert,
  PlotText, Plot/PlotN/NoPlot) e construções básicas de controle de fluxo.
  Itens sinalizados com "VERIFICAR" no comentário precisam ser conferidos
  no seu editor NTSL antes de considerar o código pronto. Ver PARTE 6 da
  resposta para a lista completa de pontos a validar.
==================================================================================
}

input
    Janela(5);                  // janela de progressão/persistência, em barras de 60K
    JanelaERD(5);                // janela para "novo extremo" do ERD (não 1 barra)

    MinRI(30.0);
    MinWick(25.0);
    MinEvidence(30.0);           // limiar de rejeição ATIVA (STATE 3)
    MinEvidenceDeveloping(15.0); // limiar de rejeição EM DESENVOLVIMENTO (STATE 2) — deve ser < MinEvidence

    MinSlope(2.0);
    MinAcceleration(1.0);

    MinPersistence(4);

    VolumeMedia(20);
    MinVolumeRatio(1.20);

    MinDeltaDivergence(0.0);

    ToleranciaConflito(5.0);     // |URE-LRE| abaixo disso = conflito/neutro

    MostrarDE(true);
    MostrarRI(true);
    MostrarURE(true);
    MostrarLRE(true);
    MostrarEstados(true);
    MostrarSinais(true);


var
    // PREÇO
    Rng             : Float;
    Body            : Float;
    Disp            : Float;

    DE              : Float;
    RI              : Float;

    UpperWick       : Float;
    LowerWick       : Float;
    UpperWickPct    : Float;
    LowerWickPct    : Float;

    CloseLocation   : Float;
    HighFailure     : Float;
    LowFailure      : Float;

    URE             : Float;
    LRE             : Float;

    // PROGRESSÃO
    URP             : Float;
    LRP             : Float;
    URPPrev         : Float;
    LRPPrev         : Float;

    URSlope         : Float;
    LRSlope         : Float;

    URAccel         : Float;
    LRAccel         : Float;

    // PERSISTÊNCIA
    CountUpper      : Integer;
    CountLower      : Integer;
    PersistentUpper : Boolean;
    PersistentLower : Boolean;

    // ERD (agora com janela N, não 1 barra)
    PriorHighExt    : Float;
    PriorLowExt     : Float;
    ERDUp           : Boolean;
    ERDDown         : Boolean;

    // VOLUME
    VolMedia        : Float;
    VolumeRatio     : Float;

    // DELTA
    DeltaAtual      : Float;
    DeltaAnterior   : Float;
    DeltaChange     : Float;
    PriceChange     : Float;
    FlowDivergence  : Integer;

    // CLASSIFICAÇÃO
    UpperRejection  : Boolean;
    LowerRejection  : Boolean;

    // CONFLITO (item 27 da especificação)
    EvidenceDiff    : Float;
    RejectionConflict : Boolean;
    UpperDominant   : Boolean;
    LowerDominant   : Boolean;

    // ESTADOS
    State           : Integer;
    Progressive     : Boolean;
    Persistent      : Boolean;
    FlowConfirmed   : Boolean;
    ReversalCandidate : Boolean;

    // CONTROLE
    i               : Integer;

begin

    // ============================================================
    // PROTEÇÃO — barras insuficientes para as janelas usadas
    // ============================================================
    if CurrentBar > (Janela + JanelaERD + 2) then
    begin

        // ========================================================
        // 1. ESTRUTURA DO CANDLE
        // ========================================================
        Rng  := High - Low;
        Body := Abs(Close - Open);
        Disp := Close - Open;

        if Rng > 0 then
        begin

            DE := (Body / Rng) * 100.0;
            RI := 100.0 - DE;

            UpperWick := High - Max(Open, Close);
            LowerWick := Min(Open, Close) - Low;

            UpperWickPct := (UpperWick / Rng) * 100.0;
            LowerWickPct := (LowerWick / Rng) * 100.0;

            CloseLocation := ((Close - Low) / Rng) * 100.0;

            HighFailure := 100.0 - CloseLocation;
            LowFailure  := CloseLocation;

            // Evidência de rejeição = wick% ponderado pela falha de sustentação
            URE := UpperWickPct * (HighFailure / 100.0);
            LRE := LowerWickPct * (LowFailure  / 100.0);

        end
        else
        begin
            // Regra combinada: Range<=0 não produz leitura de rejeição.
            // (mantemos valores neutros em vez de pular o bloco inteiro,
            // para não quebrar as séries históricas usadas mais abaixo)
            DE := 0;  RI := 0;
            UpperWick := 0;  LowerWick := 0;
            UpperWickPct := 0;  LowerWickPct := 0;
            CloseLocation := 50;  HighFailure := 50;  LowFailure := 50;
            URE := 0;  LRE := 0;
        end;


        // ========================================================
        // 2. PROGRESSÃO / SLOPE / ACELERAÇÃO
        // ========================================================
        URP := URE - URE[1];
        LRP := LRE - LRE[1];

        URPPrev := URE[1] - URE[2];
        LRPPrev := LRE[1] - LRE[2];

        // Slope simplificado: variação total na janela dividida pela janela
        // (a especificação deixou aberto "regressão linear ou diferença
        // normalizada" — usamos a segunda por simplicidade nesta V1)
        URSlope := (URE - URE[Janela]) / Janela;
        LRSlope := (LRE - LRE[Janela]) / Janela;

        URAccel := URP - URPPrev;
        LRAccel := LRP - LRPPrev;


        // ========================================================
        // 3. PERSISTÊNCIA
        // VERIFICAR: indexação de série com variável de loop (URE[i]).
        // Costuma funcionar em linguagens com histórico automático de
        // variáveis (padrão EasyLanguage-like), mas confirme no seu
        // editor NTSL antes de confiar neste bloco.
        // ========================================================
        CountUpper := 0;
        CountLower := 0;

        for i := 0 to Janela - 1 do
        begin
            if URE[i] >= MinEvidence then
                CountUpper := CountUpper + 1;

            if LRE[i] >= MinEvidence then
                CountLower := CountLower + 1;
        end;

        PersistentUpper := CountUpper >= MinPersistence;
        PersistentLower := CountLower >= MinPersistence;


        // ========================================================
        // 4. EXTREME REJECTION DIVERGENCE (ERD) — agora com janela N
        // Corrige a versão anterior, que comparava só com High[1]/Low[1].
        // Aqui comparamos com o maior/menor das JanelaERD barras
        // ANTERIORES (excluindo a barra atual).
        // ========================================================
        PriorHighExt := High[1];
        PriorLowExt  := Low[1];

        for i := 2 to JanelaERD do
        begin
            if High[i] > PriorHighExt then
                PriorHighExt := High[i];

            if Low[i] < PriorLowExt then
                PriorLowExt := Low[i];
        end;

        ERDUp   := (High > PriorHighExt) and (URE > URE[1]) and (DE < DE[1]);

        ERDDown := (Low < PriorLowExt) and (LRE > LRE[1]) and (DE < DE[1]);


        // ========================================================
        // 5. VOLUME RELATIVO
        // ========================================================
        VolMedia := MediaExp(VolumeMedia, Volume);

        if VolMedia > 0 then
            VolumeRatio := Volume / VolMedia
        else
            VolumeRatio := 1.0;


        // ========================================================
        // 6. DELTA DE AGRESSÃO
        // ========================================================
        DeltaAtual    := AgressionVolBalance;
        DeltaAnterior := DeltaAtual[1];
        DeltaChange   := DeltaAtual - DeltaAnterior;
        PriceChange   := Close - Close[1];

        FlowDivergence := 0;

        // Preço sobe e delta perde força (divergência compradora deteriorando)
        if (PriceChange > 0) and (DeltaChange < MinDeltaDivergence) then
            FlowDivergence := -1;

        // Preço cai e delta perde força no lado vendedor (divergência vendedora deteriorando)
        if (PriceChange < 0) and (DeltaChange > MinDeltaDivergence) then
            FlowDivergence := 1;


        // ========================================================
        // 7. CLASSIFICAÇÃO PRIMÁRIA (rejeição ATIVA)
        // ========================================================
        UpperRejection := (RI >= MinRI) and (UpperWickPct >= MinWick) and (URE >= MinEvidence);
        LowerRejection := (RI >= MinRI) and (LowerWickPct >= MinWick) and (LRE >= MinEvidence);


        // ========================================================
        // 8. CONFLITO ENTRE REJEIÇÕES (item 27 da especificação)
        // ========================================================
        EvidenceDiff := URE - LRE;
        RejectionConflict := false;
        UpperDominant := false;
        LowerDominant := false;

        if UpperRejection and LowerRejection then
        begin
            if Abs(EvidenceDiff) <= ToleranciaConflito then
                RejectionConflict := true
            else if EvidenceDiff > 0 then
                UpperDominant := true
            else
                LowerDominant := true;
        end
        else
        begin
            UpperDominant := UpperRejection;
            LowerDominant := LowerRejection;
        end;


        // ========================================================
        // 9. PROGRESSÃO (slope OU aceleração — "e/ou" da especificação,
        // não slope E aceleração como na primeira versão)
        // ========================================================
        Progressive := false;

        if UpperDominant and ((URSlope >= MinSlope) or (URAccel >= MinAcceleration)) then
            Progressive := true;

        if LowerDominant and ((LRSlope >= MinSlope) or (LRAccel >= MinAcceleration)) then
            Progressive := true;


        // ========================================================
        // 10. PERSISTÊNCIA
        // ========================================================
        Persistent := false;

        if UpperDominant and PersistentUpper then
            Persistent := true;

        if LowerDominant and PersistentLower then
            Persistent := true;


        // ========================================================
        // 11. CONFIRMAÇÃO DE FLUXO
        // Removida a condição solta "DeltaAtual < DeltaAnterior" isolada
        // (não exigia direção do preço) — agora exige divergência real.
        // ========================================================
        FlowConfirmed := false;

        if UpperDominant and (FlowDivergence = -1) and (VolumeRatio >= MinVolumeRatio) then
            FlowConfirmed := true;

        if LowerDominant and (FlowDivergence = 1) and (VolumeRatio >= MinVolumeRatio) then
            FlowConfirmed := true;


        // ========================================================
        // 12. CANDIDATO A REVERSÃO
        // ========================================================
        ReversalCandidate := (UpperDominant or LowerDominant) and Progressive and Persistent and FlowConfirmed;


        // ========================================================
        // 13. MÁQUINA DE ESTADOS (cascata — corrige o bug do State 2
        // inalcançável usando um limiar DISTINTO e mais baixo para
        // "developing" do que o usado para "active")
        // ========================================================
        State := 0;

        if RI >= MinRI then
            State := 1;

        if (URE >= MinEvidenceDeveloping) or (LRE >= MinEvidenceDeveloping) then
            State := 2;

        if UpperDominant or LowerDominant then
            State := 3;

        if Progressive then
            State := 4;

        if Persistent then
            State := 5;

        if FlowConfirmed then
            State := 6;

        if ReversalCandidate then
            State := 7;


        // ========================================================
        // 14. PLOTS
        // ========================================================
        if MostrarDE then Plot(DE) else NoPlot(1);
        if MostrarRI then Plot2(RI) else NoPlot(2);
        if MostrarURE then Plot3(URE) else NoPlot(3);
        if MostrarLRE then Plot4(LRE) else NoPlot(4);
        if MostrarEstados then Plot5(State) else NoPlot(5);


        // ========================================================
        // 15. MARCAÇÕES NO GRÁFICO
        // ========================================================
        if MostrarSinais then
        begin

            if RejectionConflict then
                PlotText("CONFLICT", 0, Close);

            if UpperDominant then
                PlotText("REJ SUP", 0, High + (Rng * 0.15));

            if LowerDominant then
                PlotText("REJ INF", 0, Low - (Rng * 0.15));

            if ERDUp then
                PlotText("ERD UP", 0, High + (Rng * 0.30));

            if ERDDown then
                PlotText("ERD DOWN", 0, Low - (Rng * 0.30));

            if FlowConfirmed then
                PlotText("FLOW", 0, Close);

            if ReversalCandidate then
                PlotText("REVERSAO", 0, Close);

        end;

    end;

end;
