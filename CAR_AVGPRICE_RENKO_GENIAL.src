// BRICKMASTER
// Método inspirado no Método 9.1 do Larry Williams e o Método de Joseph Reffson (MeJoRe)(Newton–Raphson).
// Nome: CAR_AVGPRICE_RENKO
// Versão 01. // RENKO 35R NO WIN E 8R NO WDOL.  //PROMISSOR. //APRESENTOU OS MELHORES RESULTADOS.
// Estrutura Cinética

//19.1 Função AvgPrice - é o motor no robô.

//TRABALHAR O Função Range (Filtro 1 — Range mínimo) SUGERIDA PELA CHATGP.

input
  offSet(20); // 20 para o WIN e WDOL no 30R. //altera o Drawndown e o Fator de Lucro.
  candleavg0 (0); candleavg1 (1); candleavg2 (2);
  candleent (0);
  candlesai (2);
var
  vlrStopC,  vlrStopV     : real;
  sinalC,    sinalV       : booleano;
  vAvgPrice, vEstrategia  : real;
  gOffset : Integer; 
  nRange : float;
  

  // TRABALHAR A FUNÇÃO Função Bid E ANALISAR OS RESULTADOS.
  // Função BookSpread
  // Função MinPriceIncrement
  
   
begin
  
  //em avalidação:
  //19.8 Função GraphicOffset
  
  //HorizontalLine(183400, RGB(200, 0, 0));
  
  //HorizontalLine(Open, RGB(0, 255, 0));        //Verde
  //HorizontalLine(Close, RGB(255, 0, 0));       //Vermelho
  //HorizontalLine(maxima, RGB(0, 255, 200));
  //HorizontalLine(minima, RGB(200, 255, 0)); 
  
  
  // PASSO 1 | CARREGAR INDICADORES  
  vAvgPrice := AvgPrice();                                                     
  vEstrategia := vAvgPrice;
  nRange := Range();
  gOffset := GraphicOffset();
     
  //-----------PADRÃO----------
  //EXECUÇÃO DE ENTRADA //PASSO 2
  sinalC := (vEstrategia[candleavg2] > vEstrategia[candleavg1]) e (vEstrategia[candleavg1] < vEstrategia[candleavg0]); // \/
  sinalV := (vEstrategia[candleavg2] < vEstrategia[candleavg1]) e (vEstrategia[candleavg1] > vEstrategia[candleavg0]); // /\
  
  se ( not HasPosition) e sinalC entao
    BuyStop((vEstrategia[candleent] + MinPriceIncrement),(vEstrategia[candleent] + MinPriceIncrement) + (offSet * MinPriceIncrement));
  se ( not HasPosition) e sinalV entao
    SellShortStop((vEstrategia[candleent] - MinPriceIncrement),(vEstrategia[candleent] - MinPriceIncrement) - (offSet * MinPriceIncrement));
  
  //EXECUÇÃO DE SAÍDA //PASSO 3
  vlrStopC := (minima[candlesai]); //PADRÃO: [0] PARA PERDER DE 5 A 10 PONTOS NO WINFUT.
  vlrStopV := (maxima[candlesai]); //PADRÃO: [0] PARA PERDER DE 5 A 10 PONTOS NO WINFUT.

  se IsBought entao
    SellToCoverStop(vlrStopC,vlrStopC - (offSet * MinPriceIncrement));
  se IsSold entao
    BuyToCoverStop(vlrStopV,vlrStopv + (offSet * MinPriceIncrement));
  
  //EXECUCAO DE SAIDA EM GAP
  se IsBought e (vEstrategia < vlrStopC) entao closeposition;
  se IsSold e (vEstrategia > vlrStopV) entao closeposition;
  
  //BuyStop adicionado:
  HorizontalLine(vEstrategia[2], RGB(255, 255, 0)); //Amarela  // Função: Marcar a posição da estratégia.  
  HorizontalLine(vEstrategia[1], RGB(0, 0, 255)); //Azul       // Função: Marcar a posição do tralingstop.

 // 19.22 Função PlotText
 if (vEstrategia[2] > vEstrategia[1]) and (vEstrategia[1] < vEstrategia[0]) then PlotText("Sinal de Compra!", clAzul, 1, 10)
else if (vEstrategia[2] < vEstrategia[1]) and (vEstrategia[1] > vEstrategia[0]) then PlotText("Sinal de Venda!", clAmarelo, 1, 10);

  //COLORAÇÃO
  SetPlotColor(1,RGB(0, 0, 255));
  SetPlotColor(5,RGB(255, 0, 0));
  //ESPESSURA
  SetPlotWidth(1,2);
  //ESTILO DA LINHA
  //SetPlotStyle(1,0);
  //PLOTAGEM
  Plot(vEstrategia); 
  Plot2(offSet);
  Plot3(gOffset); 
  Plot4(nRange); 
  //Plot5();
  
    
end;
