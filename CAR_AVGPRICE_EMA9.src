// BRICKMASTER v3 (AVGPRICE_9.1)
// Método inspirado no Método 9.1 do Larry Williams e o Método de Joseph Reffson (MeJoRe)(Newton–Raphson).
// Nome: CAR_AVGPRICE_RENKO
// Versão 01. // RENKO 35R NO WIN E 8R NO WDOL.  //PROMISSOR. //APRESENTOU OS MELHORES RESULTADOS.
// Estrutura Cinética

//19.1 Função AvgPrice - é o motor no robô.

input
  offSet(20); // 20 para o WIN e WDOL no 30R. //altera o Drawndown e o Fator de Lucro.
  
var
  vlrStopC,  vlrStopV     : real;
  sinalC,    sinalV       : booleano;
  vAvgPrice, vEstrategia1, vEstrategia2  : real;
  gOffset : Integer; 
  nRange : float;
  vEMA9 : real;
  

  // TRABALHAR A FUNÇÃO Função Bid E ANALISAR OS RESULTADOS.
  // Função BookSpread
  // Função MinPriceIncrement
  
   
begin
  
  //em avalidação:
  //19.8 Função GraphicOffset
  
  //HorizontalLine(183400, RGB(200, 0, 0));
  
  //HorizontalLine(Open, RGB(0, 255, 0));        //Verde
  //HorizontalLine(Close, RGB(255, 0, 0));       //Vermelho
  //HorizontalLine(maxima, RGB(0, 255, 200));
  //HorizontalLine(minima, RGB(200, 255, 0)); 
  
  
  // PASSO 1 | CARREGAR INDICADORES  
  vAvgPrice := AvgPrice(); 
  vEMA9 := MediaExp(9, close);
  nRange := Range();
  gOffset := GraphicOffset();

  
     
  //-----------PADRÃO----------
  //EXECUÇÃO DE ENTRADA //PASSO 2
  //sinalC := (vEstrategia[2] > vEstrategia[1]) e (vEstrategia[1] < vEstrategia[0]); // \/
  //sinalV := (vEstrategia[2] < vEstrategia[1]) e (vEstrategia[1] > vEstrategia[0]); // /\

  //sinalC := (vEstrategia1[1] > vEstrategia2[0]); // SE EMA9 FOR MAIOR QUE AVGPRICE.
  //sinalV := (vEstrategia1[1] < vEstrategia2[0]); // SE EMA9 FOR MENOR QUE AVGPRICE.

  sinalC := (vEMA9 > vAvgPrice); // SE EMA9 FOR MAIOR QUE AVGPRICE.
  sinalV := (vEMA9 < vAvgPrice); // SE EMA9 FOR MENOR QUE AVGPRICE.
  
  se ( not HasPosition) e sinalC entao
    BuyStop((vAvgPrice[0] + MinPriceIncrement),(vAvgPrice[0] + MinPriceIncrement) + (offSet * MinPriceIncrement));
  se ( not HasPosition) e sinalV entao
    SellShortStop((vAvgPrice[0] - MinPriceIncrement),(vAvgPrice[0] - MinPriceIncrement) - (offSet * MinPriceIncrement));
  
  //EXECUÇÃO DE SAÍDA //PASSO 3  // PREÇO PRECISA ROMPER A ESTRATÉGIA1 = EMA9.
  vlrStopC := (vAvgPrice[1]); //PADRÃO: [0] // DIFERENÇA DE UMA MÉDIA PARA A OUTRA.
  vlrStopV := (vAvgPrice[1]); //PADRÃO: [0] //PARA PERDER DE 5 A 10 PONTOS NO WINFUT.

  se IsBought entao
    SellToCoverStop(vlrStopC,vlrStopC - (offSet * MinPriceIncrement));
  se IsSold entao
    BuyToCoverStop(vlrStopV,vlrStopv + (offSet * MinPriceIncrement));
  
  //EXECUCAO DE SAIDA EM GAP
  se IsBought e (vAvgPrice < vlrStopC) entao closeposition;
  se IsSold e (vAvgPrice > vlrStopV) entao closeposition;
  
  //BuyStop adicionado:
  HorizontalLine(vEMA9[2], RGB(255, 255, 0)); //Amarela  // Função: Marcar a posição da estratégia.  
  HorizontalLine(vAvgPrice[2], RGB(0, 0, 255)); //Azul       // Função: Marcar a posição do tralingstop.

  
 // 19.22 Função PlotText
 // if (vEstrategia1[1] > vEstrategia2[0]) then PlotText("Sinal de Compra!", clAzul, 2, 10)
// else if (vEstrategia1[1] < vEstrategia2[0]) then PlotText("Sinal de Venda!", clAmarelo, 0, 10);

//if sinalC then PlotText("Sinal de Compra!", clAzul, 2, 10)
//else if sinalV then PlotText("Sinal de Venda!", clAmarelo, 0, 10);

  //COLORAÇÃO
  SetPlotColor(1,RGB(0, 0, 255)); //AVGPRICE, VERMELHA  
  SetPlotColor(5,RGB(255, 0, 0)); //EMA9, AZUL
  //ESPESSURA
  SetPlotWidth(1,2);
  SetPlotWidth(5,3);
  //ESTILO DA LINHA
  //SetPlotStyle(1,0);
  //PLOTAGEM
  Plot (vAvgPrice); 
  Plot2(offSet);
  Plot3(gOffset); 
  Plot4(nRange); 
  Plot5(vEMA9);
  
    
end;
