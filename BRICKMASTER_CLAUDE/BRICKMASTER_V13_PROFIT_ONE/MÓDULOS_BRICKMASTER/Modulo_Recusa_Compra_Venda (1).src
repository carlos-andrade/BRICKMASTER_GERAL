{
==================================================================================
  MÓDULO DE CONFIRMAÇÃO DE RECUSA (COMPRA / VENDA)
  Autor: Carlos | Plataforma: Profit One / Nelogica | Linguagem: NTSL
  Tipo: Indicador standalone (não integrado ao BRICKMASTER V12)
==================================================================================

  LÓGICA (confirmada por conferência manual do usuário):

    Amplitude              = Máxima - Mínima
    Variação               = Fechamento - Abertura
    EficiênciaDirecional   = (|Variação| / Amplitude) * 100
    RecusaDesperdício      = 100 - EficiênciaDirecional

  Exemplo real (candle 03/02 09:21:49): Amplitude=217, Variação=100,20
    -> Eficiência = 100,20/217*100 = 46,18%
    -> Recusa/Desperdício = 100 - 46,18 = 53,82%

  A Recusa/Desperdício é então atribuída a um lado conforme o sinal da Variação:
  - Variação >= 0 (fechou em alta)  -> a "perda" veio de tentativas de VENDA
    que não conseguiram reverter o candle -> PercRecusaVenda = RecusaDesperdício
  - Variação <  0 (fechou em baixa) -> a "perda" veio de tentativas de COMPRA
    que não conseguiram reverter o candle -> PercRecusaCompra = RecusaDesperdício

  INTERPRETAÇÃO:
  - EficiênciaDirecional alto -> o candle andou "limpo" na direção do
    fechamento, com pouco desperdício de amplitude (baixa disputa).
  - PercRecusaCompra/Venda alto -> grande parte da amplitude do candle foi
    desperdiçada tentando ir contra o fechamento final (recusa do lado oposto).
  - A PROGRESSÃO (vários candles seguidos com recusa alta do mesmo lado)
    é o sinal mais forte de rejeição de uma direção.

  Ajuste o parâmetro LimiteAlerta conforme sua sensibilidade desejada.
==================================================================================
}

Input
  LimiteAlerta(80);      { % mínimo de recusa para disparar alerta }
  MediaRecusa(3);        { períodos para suavizar a progressão de recusa }

Var
  Amplitude, Variacao, PercEficiencia, PercRecusaDesperdicio : Float;
  PercRecusaCompra, PercRecusaVenda : Float;
  MediaRecusaCompra, MediaRecusaVenda : Float;
  CorCompra, CorVenda, CorEficiencia : Integer;

Begin

  { --- Cálculo do candle atual --- }
  Amplitude := Maxima(0) - Minima(0);
  Variacao  := Fechamento(0) - Abertura(0);

  If Amplitude > 0 then
    PercEficiencia := (AbsValor(Variacao) / Amplitude) * 100
  Else
    PercEficiencia := 0;

  PercRecusaDesperdicio := 100 - PercEficiencia;

  If Variacao >= 0 then
  Begin
    PercRecusaVenda  := PercRecusaDesperdicio;   { fechou em alta: recusa do lado vendedor }
    PercRecusaCompra := 0;
  End
  Else
  Begin
    PercRecusaCompra := PercRecusaDesperdicio;   { fechou em baixa: recusa do lado comprador }
    PercRecusaVenda  := 0;
  End;

  { --- Progressão (média móvel simples da recusa, para ver tendência) --- }
  MediaRecusaCompra := Media(MediaRecusa, PercRecusaCompra);
  MediaRecusaVenda  := Media(MediaRecusa, PercRecusaVenda);

  { --- Plotagem --- }
  CorCompra     := IfThenElse(PercRecusaCompra >= LimiteAlerta, RGB(255, 0, 0), RGB(255, 140, 140));
  CorVenda      := IfThenElse(PercRecusaVenda  >= LimiteAlerta, RGB(0, 160, 0), RGB(140, 220, 140));
  CorEficiencia := RGB(120, 120, 255);

  Plot1(PercRecusaCompra, "% Recusa Compra", CorCompra);
  Plot2(PercRecusaVenda,  "% Recusa Venda",  CorVenda);
  Plot3(PercEficiencia,   "% Eficiência",    CorEficiencia);
  Plot4(MediaRecusaCompra, "Média Recusa Compra", RGB(180, 0, 0));
  Plot5(MediaRecusaVenda,  "Média Recusa Venda",  RGB(0, 100, 0));

  { --- Alertas --- }
  If PercRecusaCompra >= LimiteAlerta then
    Alerta("RECUSA DE COMPRA " + ConverteTexto(Arredonde(PercRecusaCompra, 1)) + "% no candle atual");

  If PercRecusaVenda >= LimiteAlerta then
    Alerta("RECUSA DE VENDA " + ConverteTexto(Arredonde(PercRecusaVenda, 1)) + "% no candle atual");

End;
