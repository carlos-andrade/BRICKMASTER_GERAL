// ============================================================================
// BRICKMASTER - REJECTION ENGINE V1.1 - NUCLEO 60K

// NOME NO CHATGPT: BRICKMASTER — REJECTION ENGINE V1.0
// NOME NO PROFIT: REJECTION_ENGINE_V1.1

// ============================================================================
// Modulo independente de diagnostico.
// Grafico alvo: WINFUT 60.000 TICKS
// Nao executa ordens.
// Nao usa VIX, RSI, MACD, FVG, VWAP ou TWAP.
//
// Nucleo desta versao:
// Range, Corpo, DE, RI, pavios, Close Location, URE e LRE.
//
// Esta versao foi deliberadamente reduzida para validar primeiro
// o nucleo matematico e a estrutura do parser NTSL.
// ============================================================================

input
  MinRI(30.0);
  MinWick(25.0);
  MinEvidence(20.0);

var
  RangeCandle : Float;
  Corpo : Float;
  Deslocamento : Float;
  DE : Float;
  RI : Float;

  PavioSuperior : Float;
  PavioInferior : Float;
  PavioSuperiorPct : Float;
  PavioInferiorPct : Float;

  CloseLocation : Float;
  HighFailure : Float;
  LowFailure : Float;

  URE : Float;
  LRE : Float;

  RejeicaoSuperior : Boolean;
  RejeicaoInferior : Boolean;

begin

  // --------------------------------------------------------------------------
  // 1. RANGE E DESLOCAMENTO
  // --------------------------------------------------------------------------

  RangeCandle := High - Low;
  Deslocamento := Close - Open;
  Corpo := Abs(Deslocamento);

  DE := 0;
  RI := 100;

  PavioSuperior := 0;
  PavioInferior := 0;
  PavioSuperiorPct := 0;
  PavioInferiorPct := 0;

  CloseLocation := 50;
  HighFailure := 50;
  LowFailure := 50;

  URE := 0;
  LRE := 0;

  // --------------------------------------------------------------------------
  // 2. METRICAS DO CANDLE
  // --------------------------------------------------------------------------

  if RangeCandle > 0 then
  begin

    DE := (Corpo / RangeCandle) * 100;

    if DE > 100 then
      DE := 100;

    RI := 100 - DE;

    // Pavio superior
    if Open > Close then
      PavioSuperior := High - Open
    else
      PavioSuperior := High - Close;

    // Pavio inferior
    if Open < Close then
      PavioInferior := Open - Low
    else
      PavioInferior := Close - Low;

    PavioSuperiorPct := (PavioSuperior / RangeCandle) * 100;
    PavioInferiorPct := (PavioInferior / RangeCandle) * 100;

    // Localizacao do fechamento dentro do range
    CloseLocation := ((Close - Low) / RangeCandle) * 100;

    HighFailure := 100 - CloseLocation;
    LowFailure := CloseLocation;

    // Evidencia de rejeicao superior
    URE := PavioSuperiorPct * (HighFailure / 100);

    // Evidencia de rejeicao inferior
    LRE := PavioInferiorPct * (LowFailure / 100);

  end;

  // --------------------------------------------------------------------------
  // 3. CLASSIFICACAO BASICA
  // --------------------------------------------------------------------------

  RejeicaoSuperior := false;
  RejeicaoInferior := false;

  if (RI >= MinRI) and
     (PavioSuperiorPct >= MinWick) and
     (URE >= MinEvidence) then
    RejeicaoSuperior := true;

  if (RI >= MinRI) and
     (PavioInferiorPct >= MinWick) and
     (LRE >= MinEvidence) then
    RejeicaoInferior := true;

  // --------------------------------------------------------------------------
  // 4. PLOTS
  // --------------------------------------------------------------------------

  Plot(DE);
  Plot2(RI);
  Plot3(URE);
  Plot4(LRE);
  Plot5(CloseLocation);
  Plot6(PavioSuperiorPct);
  Plot7(PavioInferiorPct);

end;
